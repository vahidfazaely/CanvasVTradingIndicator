//@version=5
//+------------------------------------------------------------------+
//|  CanvasV V4 BACKTEST - Strategy Tester version                   |
//|  Same signal logic as V4 FAST indicator, wrapped in strategy().   |
//|  Stripped of all UI (panels, tables, labels, lines).             |
//|  Designed for TradingView Strategy Tester + headless automation.  |
//|                                                                   |
//|  v4.1.0 - Match production indicator logic exactly               |
//+------------------------------------------------------------------+
strategy("CanvasV V4 Backtest", shorttitle="V4 BT", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.04, pyramiding=0)

//--------------------------------------------------------------
// Inputs (same defaults as V4 FAST)
//--------------------------------------------------------------
// Regime
regimeBars     = input.int(10, "Regime slope lookback", minval=2)
regimeMinSlope = input.float(0.05, "Min regime slope", minval=0)
atrRegimeLen   = input.int(100, "ATR regime lookback", minval=20)
highVolPct     = input.float(130.0, "High vol threshold %", minval=100)
atrPeriod      = input.int(14, "ATR period", minval=1)

// Direction
emaTrigLen  = input.int(9, "Trigger EMA", minval=2)
emaDirLen   = input.int(21, "Direction EMA", minval=2)
emaSlowLen  = input.int(50, "Slow EMA", minval=3)
momSlopeBars = input.int(3, "Momentum slope bars", minval=1)

// Triggers
enablePullback   = input.bool(true, "Pullback trigger")
enableBreakout   = input.bool(true, "Breakout trigger")
pullbackLookback = input.int(5, "Pullback lookback", minval=2)
pullbackTolPct   = input.float(0.5, "Pullback tolerance %", minval=0)
breakoutBars     = input.int(10, "Breakout lookback", minval=3)
maxExtAtr        = input.float(2.5, "Max extension (ATR)", minval=0.1)
minBodyPct       = input.float(0.0, "Min body % (0=off)", minval=0, maxval=100)

// Risk
swingLookback   = input.int(10, "Swing lookback", minval=2)
structBufferAtr = input.float(0.5, "Structure buffer ATR", minval=0)
minRiskAtr      = input.float(0.5, "Min risk ATR", minval=0.01)
maxRiskAtr      = input.float(2.5, "Max risk ATR", minval=0.01)
tp1R            = input.float(1.0, "TP1 R multiple", minval=0.01)
tp2R            = input.float(2.5, "TP2 R multiple", minval=0.01)
atrFallbackMult = 1.5

// Position
outcomeBars = input.int(20, "Expiry bars", minval=2)

//--------------------------------------------------------------
// Series (same as V4 FAST)
//--------------------------------------------------------------
emaTrig = ta.ema(close, emaTrigLen)
emaDir  = ta.ema(close, emaDirLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrPeriod)
atrAvg  = ta.sma(atrVal, atrRegimeLen)
atrVsAvg = atrVal / math.max(atrAvg, 1e-10) * 100
isConfirmed = barstate.isconfirmed

//--------------------------------------------------------------
// Regime
//--------------------------------------------------------------
regimeSlope = (emaSlow - emaSlow[regimeBars]) / math.max(atrVal * regimeBars, 1e-10)
trending    = math.abs(regimeSlope) >= regimeMinSlope
highVol     = atrVsAvg >= highVolPct
trendUp = trending and emaDir > emaSlow and emaSlow > emaSlow[regimeBars]
trendDn = trending and emaDir < emaSlow and emaSlow < emaSlow[regimeBars]

//--------------------------------------------------------------
// Direction + momentum
//--------------------------------------------------------------
momUp = emaTrig > emaTrig[momSlopeBars] and close >= emaDir
momDn = emaTrig < emaTrig[momSlopeBars] and close <= emaDir
setupUp = trendUp and momUp
setupDn = trendDn and momDn

//--------------------------------------------------------------
// Triggers
//--------------------------------------------------------------
pullbackTol = pullbackTolPct / 100.0
touchLowUp  = ta.lowest(low, pullbackLookback)[1] <= emaDir * (1 + pullbackTol)
touchHighDn = ta.highest(high, pullbackLookback)[1] >= emaDir * (1 - pullbackTol)
reclaimUp   = close > emaTrig and close[1] <= emaTrig[1]
reclaimDn   = close < emaTrig and close[1] >= emaTrig[1]
pullbackUp  = enablePullback and touchLowUp and reclaimUp
pullbackDn  = enablePullback and touchHighDn and reclaimDn
breakUp = enableBreakout and close > ta.highest(high, breakoutBars)[1]
breakDn = enableBreakout and close < ta.lowest(low, breakoutBars)[1]
triggerUp = pullbackUp or breakUp
triggerDn = pullbackDn or breakDn

//--------------------------------------------------------------
// Entry quality
//--------------------------------------------------------------
candleRange = high - low
bodyPct = candleRange > 0 ? math.abs(close - open) / candleRange * 100 : 0.0
bodyOkUp = minBodyPct <= 0 or (close > open and bodyPct >= minBodyPct)
bodyOkDn = minBodyPct <= 0 or (close < open and bodyPct >= minBodyPct)
extAtrUp = (close - emaDir) / math.max(atrVal, 1e-10)
extAtrDn = (emaDir - close) / math.max(atrVal, 1e-10)
extOkUp  = extAtrUp <= maxExtAtr
extOkDn  = extAtrDn <= maxExtAtr

//--------------------------------------------------------------
// Risk validation
//--------------------------------------------------------------
entry = close
atrUsable = not na(atrVal) and atrVal > 0
swingLow  = ta.lowest(low, swingLookback)[1]
swingHigh = ta.highest(high, swingLookback)[1]
structSLBuy  = swingLow  - atrVal * structBufferAtr
structSLSell = swingHigh + atrVal * structBufferAtr

riskStructBuy = entry - structSLBuy
slModeBuy     = riskStructBuy >= minRiskAtr * atrVal
slBuy         = slModeBuy ? structSLBuy : entry - atrFallbackMult * atrVal
riskBuy       = entry - slBuy
riskAtrBuy    = riskBuy / math.max(atrVal, 1e-10)
riskGateBuyOk = atrUsable and slBuy < entry and riskAtrBuy <= maxRiskAtr
tp1Buy        = entry + riskBuy * tp1R
tp2Buy        = entry + riskBuy * tp2R

riskStructSell = structSLSell - entry
slModeSell     = riskStructSell >= minRiskAtr * atrVal
slSell         = slModeSell ? structSLSell : entry + atrFallbackMult * atrVal
riskSell       = slSell - entry
riskAtrSell    = riskSell / math.max(atrVal, 1e-10)
riskGateSellOk = atrUsable and slSell > entry and riskAtrSell <= maxRiskAtr
tp1Sell        = entry - riskSell * tp1R
tp2Sell        = entry - riskSell * tp2R

//--------------------------------------------------------------
// Config sanity
//--------------------------------------------------------------
cfgOk = emaTrigLen < emaDirLen and emaDirLen < emaSlowLen and swingLookback >= 2 and tp1R > 0 and tp2R > tp1R and maxRiskAtr > minRiskAtr

//--------------------------------------------------------------
// Candidates
//--------------------------------------------------------------
candUp = isConfirmed and cfgOk and setupUp and triggerUp
candDn = isConfirmed and cfgOk and setupDn and triggerDn

entryUp = candUp and extOkUp and bodyOkUp and riskGateBuyOk and strategy.position_size <= 0
entryDn = candDn and extOkDn and bodyOkDn and riskGateSellOk and strategy.position_size >= 0

//--------------------------------------------------------------
// Strategy entries + exits
//--------------------------------------------------------------
if entryUp
    strategy.entry("LONG", strategy.long)
    strategy.exit("LONG TP/SL", "LONG",
         stop=slBuy, limit=tp2Buy)

if entryDn
    strategy.entry("SHORT", strategy.short)
    strategy.exit("SHORT TP/SL", "SHORT",
         stop=slSell, limit=tp2Sell)

//--------------------------------------------------------------
// Expiry: close stale positions
//--------------------------------------------------------------
if strategy.position_size != 0
    posBars = bar_index - strategy.opentrades.entry_bar_index(0)
    if posBars >= outcomeBars
        strategy.close_all("EXPIRY")

//--------------------------------------------------------------
// Plots (minimal - just trend context)
//--------------------------------------------------------------
trendCol = trendUp ? color.green : trendDn ? color.red : color.gray
plot(emaDir, "Direction EMA", color=trendCol, linewidth=2)
plot(emaSlow, "Slow EMA", color=color.new(color.silver, 60), linewidth=1)

plotshape(entryUp, "BUY", style=shape.triangleup, location=location.belowbar,
          color=color.green, size=size.small, text="▲")
plotshape(entryDn, "SELL", style=shape.triangledown, location=location.abovebar,
          color=color.red, size=size.small, text="▼")

//--------------------------------------------------------------
// Info table (compact - just key metrics for extraction)
//--------------------------------------------------------------
var table infoTable = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "V4 BACKTEST", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "v4.1.0", text_color=color.silver, text_size=size.small)
    table.cell(infoTable, 0, 1, "Trades", text_color=color.silver, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 0, 2, "Win%", text_color=color.silver, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(strategy.wintrades / math.max(strategy.closedtrades, 1) * 100, "#.1") + "%",
               text_color=strategy.wintrades > strategy.losstrades ? color.green : color.red, text_size=size.normal)
    table.cell(infoTable, 0, 3, "Net R", text_color=color.silver, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(strategy.netprofit / math.max(strategy.initial_capital, 1) * 100, "#.1") + "%",
               text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.normal)
    table.cell(infoTable, 0, 4, "Max DD", text_color=color.silver, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(strategy.max_drawdown / math.max(strategy.initial_capital, 1) * 100, "#.1") + "%",
               text_color=color.red, text_size=size.normal)
