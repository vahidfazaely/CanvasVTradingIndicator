//@version=5
//+------------------------------------------------------------------+
//|  CanvasV MTF Signal - TradingView (Pine Script v5)               |
//|  Multi-timeframe version of the MT5 Phase 2 logic               |
//|  v2.0.1 - hardening release (validation + repaint proof)        |
//|  v2.0.2 - renamed to CanvasV MTF Signal (display name only)      |
//|  v2.1.0 - visual/UI refinement (markers, panel, level labels)    |
//|  v2.2.0 - Signal Audit Mode (debug/diagnostic, presentation only)  |
//|  v2.3.0 - TF architecture: 4H trend + 1H confirmation + 15M entry |
//|  v2.4.0 - Signal engine policy: 15m / 1H / 4H only               |
//|  v2.5.0 - Phase 1 (v3): quality gates                             |
//|  v3.1.0 - Phase 2: structural SL + risk validation + R-based TP   |
//|  v3.2.0 - Signal Diagnostic Mode: event logger + outcome tracker   |
//|  v3.3.0 - Signal Decision Logger: first-failure chain + statistics |
//|  v3.4.0 - UI/UX cleanup: simplified color system + compact panel   |
//|  v3.4.1 - Observability: logger context fields (diagnostic only)  |
//|  v3.4.2 - Workflow: CVOUT resolution alerts + CVLOG time fields   |
//|                                                                  |
//|  ARCHITECTURE                                                    |
//|   Trend        : 4H EMA 50/200 + EMA 50 slope (closed 4H only)  |
//|   Confirmation : 1H EMA 21/50 (closed 1H only)                  |
//|   Entry        : EMA 9/21 cross + ADX + ATR on the chart TF,    |
//|                  when the chart is 15m / 1H / 4H                |
//|   Signals      : confirmed on closed candles only, no repaint   |
//|                                                                  |
//|  SIGNAL ENGINE TIMEFRAMES: 15m / 1H / 4H ONLY.                  |
//|  The engine is gated by isSupportedSignalTF, so on any other    |
//|  timeframe (1m/3m/5m/30m/2H/6H/12H/1D/1W/custom) no BUY/SELL    |
//|  signal, marker, level, score label, or alert can be generated  |
//|  - display/context only. On the 4H chart the trend uses the     |
//|  chart series (self mode); signals require barstate.isconfirmed |
//|  so a forming 4H candle can never fire a signal (no repaint).   |
//|                                                                  |
//|  H4 NON-REPAINT METHODOLOGY                                     |
//|   Each H4 value is a SEPARATE request.security call with        |
//|   lookahead = barmerge.lookahead_off. With lookahead_off the    |
//|   value only updates when an H4 candle COMPLETES: during the    |
//|   forming H4 candle it holds the last closed H4 value and is    |
//|   step-constant (it never rewrites history). At the exact H4    |
//|   boundary bar the value is the just-completed candle's final   |
//|   value - confirmed data at that bar's close. The [1] is        |
//|   applied INSIDE the H4 context, so h4e50PrevH is one H4        |
//|   candle older than h4e50H (the slope baseline). Signals are    |
//|   additionally gated by barstate.isconfirmed, so a forming      |
//|   value can never reach a signal - no lookahead, no repaint.    |
//+------------------------------------------------------------------+
indicator("CanvasV MTF Signal", shorttitle = "CanvasV MTF", overlay = true, max_lines_count = 10, max_labels_count = 50)

//--- Build version shown in the panel
VERSION = "v3.4.2"

//--------------------------------------------------------------
// Inputs (validated: no negative weights, no zero periods)
//--------------------------------------------------------------
grpTrend  = "=== Trend ==="
grpEntry  = "=== Entry ==="
grpH1     = "=== 1H Confirmation ==="
grpAdx    = "=== ADX ==="
grpRisk   = "=== Risk ==="
grpScore  = "=== Signal Scoring ==="
grpOpt    = "=== Optional Filters ==="
grpVis    = "=== Visuals ==="
grpPanel  = "=== Panel ==="
grpAlerts = "=== Alerts ==="
grpDiag   = "=== Diagnostics ==="

h4Fast = input.int(50,  "H4 EMA Fast", minval = 1, group = grpTrend)
h4Slow = input.int(200, "H4 EMA Slow", minval = 2, group = grpTrend)
min4hSep = input.float(0.10, "Min 4H regime separation (%)", minval = 0, maxval = 100, group = grpTrend)

entryFast = input.int(9,  "M15 EMA Fast", minval = 1, group = grpEntry)
entrySlow = input.int(21, "M15 EMA Slow", minval = 2, group = grpEntry)
requireGapExpansion = input.bool(true, "Require EMA gap expansion", group = grpEntry)
minBodyPct = input.float(50.0, "Min candle body (%)", minval = 0, maxval = 100, group = grpEntry)

h1Fast = input.int(21, "1H EMA Fast", minval = 1, group = grpH1)
h1Slow = input.int(50, "1H EMA Slow", minval = 2, group = grpH1)

adxWeight = input.int(25,     "ADX Weight (0 = off)", minval = 0, group = grpAdx)
adxPeriod = input.int(14,     "ADX Period",           minval = 1, group = grpAdx)
adxMin    = input.float(18.0, "ADX Minimum", minval = 0, maxval = 100, group = grpAdx)

atrPeriod       = input.int(14,     "ATR Period",            minval = 1, group = grpRisk)
swingLookback   = input.int(10,     "Swing lookback",        minval = 2, group = grpRisk)
structBufferAtr = input.float(0.5,  "Structure buffer (ATR)", minval = 0, group = grpRisk)
minRiskAtr      = input.float(0.5,  "Minimum risk (ATR)",    minval = 0.01, group = grpRisk)
maxRiskAtr      = input.float(2.5,  "Maximum risk (ATR)",    minval = 0.01, group = grpRisk)
tp1R            = input.float(1.0,  "TP1 R multiple",        minval = 0.01, group = grpRisk)
tp2R            = input.float(2.5,  "TP2 R multiple",        minval = 0.01, group = grpRisk)
atrFallbackMult = 1.5     // fixed ATR fallback (too-tight / invalid structure only)
minVolPct   = input.float(0.05, "Min volatility (ATR % of price)", minval = 0, group = grpRisk)
maxEntryDist = input.float(1.5, "Max entry distance from EMA9 (ATR)", minval = 0.1, group = grpRisk)

trendWeight  = input.int(25, "Trend Weight (0 = off)",    minval = 0, group = grpScore)
momWeight    = input.int(25, "1H Conf Weight (0 = off)", minval = 0, group = grpScore)
slopeWeight  = input.int(25, "Slope Weight (0 = off)",    minval = 0, group = grpScore)
minScore     = input.int(75, "Minimum Signal Score", minval = 0, maxval = 1000, group = grpScore)
enableStrong = input.bool(true, "Enable STRONG signals", group = grpScore)
strongScore  = input.int(100, "STRONG score threshold", minval = 0, maxval = 1000, group = grpScore)

enableSeparation = input.bool(false, "Require EMA separation", group = grpOpt)
minSeparation    = input.float(0.05, "Min EMA separation (%)", minval = 0, group = grpOpt)
enablePriceAbove = input.bool(false, "Require price on EMA21 side", group = grpOpt)
enableHtfMom     = input.bool(false, "Require H4 momentum (price vs H4 EMA)", group = grpOpt)
htfMomEma        = input.int(21,     "H4 momentum EMA period", minval = 1, group = grpOpt)
atrVolWeight     = input.int(0,      "Volatility Weight (0 = off)", minval = 0, group = grpOpt)
atrMinPct        = input.float(0.05, "Min ATR (% of price)", minval = 0, group = grpOpt)
volWeight        = input.int(0,      "Volume Weight (0 = off)", minval = 0, group = grpOpt)
volPeriod        = input.int(20,     "Volume SMA period", minval = 1, group = grpOpt)
volMult          = input.float(1.0,  "Volume min ratio (vol >= SMA * ratio)", minval = 0, group = grpOpt)

showH4EMAs   = input.bool(true, "Show H4 EMA 50/200",    group = grpVis)
showEntryEMAs = input.bool(true, "Show M15 EMA 9/21",    group = grpVis)
showMarkers  = input.bool(true, "Show BUY/SELL markers", group = grpVis)
showLevels   = input.bool(true, "Show Entry/SL/TP1/TP2 lines", group = grpVis)
showSigLabels = input.bool(true, "Show signal labels",          group = grpVis)
auditMode     = input.bool(false, "Signal Audit Mode (debug)",  group = grpVis)
decisionLogger = input.bool(false, "Signal Decision Logger",      group = grpVis)

showPanel = input.bool(true, "Show info panel", group = grpPanel)

enableAlerts = input.bool(false, "EnableAlerts", group = grpAlerts)

diagHistorySize  = input.int(20,     "Diagnostic history size", minval = 1, maxval = 100, group = grpDiag)
outcomeBars      = input.int(20,     "Outcome tracking bars", minval = 1, maxval = 100, group = grpDiag)
enableDiagAlerts = input.bool(false, "Enable diagnostic CVLOG alerts", group = grpDiag)

//--------------------------------------------------------------
// Chart timeframe role (signal-engine policy)
//  Supported signal timeframes: 15m, 1H, 4H  -> SIGNAL ENGINE ON
//  All other timeframes:         DISABLED    -> display/context only
//  The engine itself is gated by isSupportedSignalTF so unsupported
//  charts cannot generate BUY/SELL signals, markers, levels, score
//  labels, or alerts.
//--------------------------------------------------------------
tfSec     = timeframe.in_seconds(timeframe.period)
isM15     = tfSec == 900
isH1chart = tfSec == 3600
isH4chart = tfSec == 14400
isSupportedSignalTF = isM15 or isH1chart or isH4chart
tfRoleTxt    = isM15 ? "15M SIGNAL" : isH1chart ? "1H SIGNAL" : isH4chart ? "4H SIGNAL" : str.tostring(timeframe.period)
tfStatusTxt  = isSupportedSignalTF ? "SIGNAL ENGINE ENABLED" : "SIGNALS DISABLED"
tfStatusCol  = isSupportedSignalTF ? color.green : color.red
tfReasonTxt  = isSupportedSignalTF ? "" : "Use 15m / 1H / 4H"

//--------------------------------------------------------------
// HTF (H4) trend series - confirmed values only
//--------------------------------------------------------------
// Each value is requested SEPARATELY, each on a single line.
// With lookahead = barmerge.lookahead_off the value only updates
// when an H4 candle COMPLETES: during the forming H4 candle it
// holds the last closed H4 value and is step-constant, so it
// never rewrites history. A forming H4 value can never reach a
// signal (which also requires barstate.isconfirmed).
//
// h4e50H     : EMA50 of the last closed H4 candle
// h4e50PrevH : EMA50 one H4 candle BEFORE the last closed one
//              ([1] is applied inside the H4 context) - this is
//              the slope baseline
// h4e200H    : EMA200 of the last closed H4 candle
// h4momH     : EMA(htfMomEma) of the last closed H4 candle
h4e50H     = request.security(syminfo.tickerid, "240", ta.ema(close, h4Fast),    lookahead = barmerge.lookahead_off)
h4e50PrevH = request.security(syminfo.tickerid, "240", ta.ema(close, h4Fast)[1], lookahead = barmerge.lookahead_off)
h4e200H    = request.security(syminfo.tickerid, "240", ta.ema(close, h4Slow),    lookahead = barmerge.lookahead_off)
h4momH     = request.security(syminfo.tickerid, "240", ta.ema(close, htfMomEma), lookahead = barmerge.lookahead_off)

//--- Chart-series values (used only on the 4H chart, self mode)
h4e50S     = ta.ema(close, h4Fast)
h4e50PrevS = ta.ema(close, h4Fast)[1]
h4e200S    = ta.ema(close, h4Slow)
h4momS     = ta.ema(close, htfMomEma)

//--- Select the trend source by chart timeframe (literal 4H series,
//--- except on the 4H chart itself, which uses the chart series).
//--- 4H SELF-MODE REPAINT SAFETY: on the 4H chart h4e50/h4e200 are
//--- the chart's own EMA series. Intra-bar their values move with
//--- the forming candle's ticks, but signals require
//--- barstate.isconfirmed, so only the CLOSED candle's final values
//--- are ever used - a forming 4H candle can never fire a signal.
//--- The slope baseline h4e50PrevS is the previous closed 4H candle.
h4e50    = isH4chart ? h4e50S     : h4e50H
h4e50Prev = isH4chart ? h4e50PrevS : h4e50PrevH
h4e200   = isH4chart ? h4e200S    : h4e200H
h4momEma = isH4chart ? h4momS     : h4momH

//--------------------------------------------------------------
// 1H confirmation series - last CLOSED 1H candle only
//--------------------------------------------------------------
// Same lookahead_off methodology as the H4 layer, on "60" (1H).
// On the 1H chart itself the chart series is used (self mode;
// signals are additionally gated by barstate.isconfirmed).
h1FastH = request.security(syminfo.tickerid, "60", ta.ema(close, h1Fast), lookahead = barmerge.lookahead_off)
h1SlowH = request.security(syminfo.tickerid, "60", ta.ema(close, h1Slow), lookahead = barmerge.lookahead_off)
h1FastS = ta.ema(close, h1Fast)
h1SlowS = ta.ema(close, h1Slow)
h1FastV = isH1chart ? h1FastS : h1FastH
h1SlowV = isH1chart ? h1SlowS : h1SlowH
h1CloseH = request.security(syminfo.tickerid, "60", close, lookahead = barmerge.lookahead_off)
h1CloseV = isH1chart ? close : h1CloseH
h1ConfUp = h1FastV > h1SlowV
h1ConfDn = h1FastV < h1SlowV
//--- 1H momentum confirmation (HARD GATE): 1H close vs 1H EMA fast
h1MomUp = h1CloseV >= h1FastV
h1MomDn = h1CloseV <= h1FastV

//--------------------------------------------------------------
// Entry series: 15M entry timeframe (chart series on M15 charts)
//--------------------------------------------------------------
emaF  = ta.ema(close, entryFast)
emaS  = ta.ema(close, entrySlow)
//--- ADX main line: Pine has no ta.adx; ta.dmi returns [DI+, DI-, ADX]
[diplus, diminus, adxVal] = ta.dmi(adxPeriod, adxPeriod)
atrVal = ta.atr(atrPeriod)

//--------------------------------------------------------------
// Closed-candle discipline (live bar: true only at its close)
//--------------------------------------------------------------
isConfirmed = barstate.isconfirmed

//--- H4 trend & slope (closed H4 values only). Slope is STRICT:
//--- a flat EMA50 counts for neither direction (regime = NEUTRAL).
h4Bull  = h4e50 > h4e200
h4Bear  = h4e50 < h4e200
slopeUp = h4e50 > h4e50Prev
slopeDn = h4e50 < h4e50Prev
//--- 4H regime (HARD GATE): direction + strict slope + min separation.
//--- All values are confirmed 4H candles (lookahead_off / close-gated).
sep4HOk = math.abs(h4e50 - h4e200) / math.max(h4e200, 1e-10) * 100 >= min4hSep
regimeUpOk = h4Bull and slopeUp and sep4HOk
regimeDnOk = h4Bear and slopeDn and sep4HOk

//--- Entry crossover (evaluated at bar close only)
crossUp = ta.crossover(emaF, emaS)
crossDn = ta.crossunder(emaF, emaS)
adxPass = adxVal >= adxMin

//--------------------------------------------------------------
// Phase 1 quality gates (HARD GATES - a failure blocks the signal
// regardless of score; the existing score model is kept unchanged)
//--------------------------------------------------------------
//--- Entry setup structure: EMA relationship + price position
setupUp = emaF > emaS and close >= emaF
setupDn = emaF < emaS and close <= emaF
//--- EMA gap expansion (configurable, default on)
gapUp = emaF - emaS
gapDn = emaS - emaF
gapUpExp = not requireGapExpansion or gapUp > gapUp[1]
gapDnExp = not requireGapExpansion or gapDn > gapDn[1]
setupGateUp = setupUp and gapUpExp
setupGateDn = setupDn and gapDnExp
//--- Candle quality: direction + minimum body (safe division)
candleRange = high - low
candleBodyPct = candleRange > 0 ? math.abs(close - open) / candleRange * 100 : 0.0
candleUpOk = close > open and candleBodyPct >= minBodyPct
candleDnOk = close < open and candleBodyPct >= minBodyPct
//--- ADX floor (was score-only; now also a hard gate)
adxGateOk = adxVal >= adxMin
//--- Volatility floor: ATR as % of price (safe division)
atrPct = atrVal / math.max(close, 1e-10) * 100
volFloorOk = atrPct >= minVolPct
//--- Chasing filter: price distance from EMA9 in ATR units
entryDistAtr = math.abs(close - emaF) / math.max(atrVal, 1e-10)
chaseGateOk = entryDistAtr <= maxEntryDist

//--------------------------------------------------------------
// Optional filters (all OFF by default, direction-aware)
//--------------------------------------------------------------
//--- EMA separation in the direction of the cross (%)
sepBuyPct  = (emaF - emaS) / emaS * 100
sepSellPct = (emaS - emaF) / emaF * 100
sepBuyOk  = not enableSeparation or sepBuyPct  >= minSeparation
sepSellOk = not enableSeparation or sepSellPct >= minSeparation

//--- Price position vs the entry EMA 21
priceUpOk = not enablePriceAbove or close >= emaS
priceDnOk = not enablePriceAbove or close <= emaS

//--- Higher-timeframe momentum: price vs H4 EMA(htfMomEma)
htfUpOk = not enableHtfMom or close >= h4momEma
htfDnOk = not enableHtfMom or close <= h4momEma

//--- Volatility regime (ATR as % of price; atrPct defined above)
volOk    = not (atrVolWeight > 0) or atrPct >= atrMinPct

//--- Volume confirmation (tick/real volume depending on feed)
volSma    = ta.sma(volume, volPeriod)
volConfOk = not (volWeight > 0) or volume >= volSma * volMult

buyGate  = sepBuyOk  and priceUpOk and htfUpOk and volOk and volConfOk
sellGate = sepSellOk and priceDnOk and htfDnOk and volOk and volConfOk

//--------------------------------------------------------------
// Scoring: configurable weights, default 25/25/25/25 (100 max)
//--------------------------------------------------------------
maxScore = trendWeight + momWeight + adxWeight + slopeWeight + atrVolWeight + volWeight

//--- Config guards: EMA periods must be sane, weights must be >= 0
//--- (input minval), not all weights can be zero, and the minimum
//--- score can never exceed the maximum achievable score. Any
//--- violation blocks signals and shows the reason in the panel.
periodsOk = h4Fast < h4Slow and entryFast < entrySlow and h1Fast < h1Slow
//--- Risk config must be sane: a usable lookback, non-negative buffer,
//--- positive minimum risk, max risk above min, and valid R multiples.
riskCfgOk = swingLookback >= 2 and structBufferAtr >= 0 and minRiskAtr > 0 and maxRiskAtr > minRiskAtr and tp1R > 0 and tp2R > tp1R
scoreOk   = maxScore > 0 and minScore <= maxScore
configOk  = periodsOk and riskCfgOk and scoreOk
cfgReason = not periodsOk ? "EMA fast >= slow" : not riskCfgOk ? "risk config invalid" : maxScore <= 0 ? "all weights are 0" : minScore > maxScore ? "min score > max" : ""

buyScore  = (h4Bull   ? trendWeight : 0) + (h1ConfUp ? momWeight : 0) + (adxPass ? adxWeight : 0) + (slopeUp  ? slopeWeight : 0) + (volOk ? atrVolWeight : 0) + (volConfOk ? volWeight : 0)
sellScore = (h4Bear   ? trendWeight : 0) + (h1ConfDn ? momWeight : 0) + (adxPass ? adxWeight : 0) + (slopeDn  ? slopeWeight : 0) + (volOk ? atrVolWeight : 0) + (volConfOk ? volWeight : 0)

//--------------------------------------------------------------
// Position / Risk model (Phase 2): structural SL + R-based TP
//  entry        = close of the confirmed signal candle
//  structural SL = swing (bars [1..swingLookback] back; the signal
//                  candle is EXCLUDED via the mandatory [1]) +- ATR
//                  * structure buffer  - chart series only, no
//                  request.security, no lookahead, no future bars
//  risk         = |entry - final SL|  (the source of truth for TPs)
//  TPs          = entry +- risk * R multiple  (NOT from ATR)
//  ATR fallback = structural stop too tight / invalid (risk <
//                  minimumRiskATR * ATR) -> SL = entry -+ 1.5 * ATR
//  Risk gate    = risk > maximumRiskATR * ATR  -> NO SIGNAL (hard)
//  ATR safety   = na / zero ATR -> NO SIGNAL (no manufactured risk)
//  Repaint: all inputs are confirmed values; [1] excludes the
//  forming candle; final SL/TP/risk are deterministic after close.
//--------------------------------------------------------------
entry = close

//--- ATR must be usable: na or zero ATR => no valid position (all
//--- divisions below use math.max() guards, never divide by zero)
atrUsable = not na(atrVal) and atrVal > 0

//--- Structural swings: previously completed bars ONLY. The [1] is
//--- mandatory - the forming signal candle must never define its
//--- own structural swing (no repaint, no lookahead).
swingLow  = ta.lowest(low,  swingLookback)[1]
swingHigh = ta.highest(high, swingLookback)[1]

//--- Raw structural stops (may be tight/invalid; the final SL below
//--- falls back to ATR when the structure is too tight)
structSLBuy  = swingLow  - atrVal * structBufferAtr
structSLSell = swingHigh + atrVal * structBufferAtr

//--- BUY position
riskStructBuy = entry - structSLBuy
slModeBuy     = riskStructBuy >= minRiskAtr * atrVal   // false: too tight / invalid -> fallback
slBuy         = slModeBuy ? structSLBuy : entry - atrFallbackMult * atrVal
riskBuy       = entry - slBuy
riskAtrBuy    = riskBuy / math.max(atrVal, 1e-10)
riskGateBuyOk = atrUsable and slBuy < entry and riskAtrBuy <= maxRiskAtr
//--- TPs are risk-based (never from ATR). R:R is computed from the
//--- actual prices so it always stays correct if inputs change.
tp1Buy        = entry + riskBuy * tp1R
tp2Buy        = entry + riskBuy * tp2R
rrTp1Buy      = (tp1Buy - entry) / math.max(riskBuy, 1e-10)
rrTp2Buy      = (tp2Buy - entry) / math.max(riskBuy, 1e-10)

//--- SELL position (mirror)
riskStructSell = structSLSell - entry
slModeSell     = riskStructSell >= minRiskAtr * atrVal
slSell         = slModeSell ? structSLSell : entry + atrFallbackMult * atrVal
riskSell       = slSell - entry
riskAtrSell    = riskSell / math.max(atrVal, 1e-10)
riskGateSellOk = atrUsable and slSell > entry and riskAtrSell <= maxRiskAtr
tp1Sell        = entry - riskSell * tp1R
tp2Sell        = entry - riskSell * tp2R
rrTp1Sell      = (entry - tp1Sell) / math.max(riskSell, 1e-10)
rrTp2Sell      = (entry - tp2Sell) / math.max(riskSell, 1e-10)

//--- BUY requires a supported signal timeframe (15m/1H/4H) + 4H
//--- trend + 1H confirmation + entry crossover + score >= minimum
//--- + valid position risk (final hard gate). On unsupported charts
//--- isSupportedSignalTF is false, so the signal engine (and
//--- therefore markers, levels, labels and alerts) cannot fire.
buySig  = isConfirmed and configOk and isSupportedSignalTF and regimeUpOk and h1ConfUp and h1MomUp and setupGateUp and crossUp and candleUpOk and adxGateOk and volFloorOk and chaseGateOk and buyGate  and buyScore  >= minScore and riskGateBuyOk
//--- SELL mirrors BUY
sellSig = isConfirmed and configOk and isSupportedSignalTF and regimeDnOk and h1ConfDn and h1MomDn and setupGateDn and crossDn and candleDnOk and adxGateOk and volFloorOk and chaseGateOk and sellGate and sellScore >= minScore and riskGateSellOk

//--- STRONG signals: higher score threshold (configurable, optional)
strongBuy  = buySig  and enableStrong and buyScore  >= strongScore
strongSell = sellSig and enableStrong and sellScore >= strongScore

//--------------------------------------------------------------
// EMAs on the chart (individually toggleable)
//--------------------------------------------------------------
plot(showH4EMAs    ? h4e50 : na, "H4 EMA 50",    color = color.new(color.blue, 0),       linewidth = 1)
plot(showH4EMAs    ? h4e200 : na, "H4 EMA 200",  color = color.new(color.orange, 0),      linewidth = 2)
plot(showEntryEMAs ? emaF   : na, "Entry EMA 9", color = color.new(color.blue, 0),        linewidth = 1)
plot(showEntryEMAs ? emaS   : na, "Entry EMA 21",color = color.new(color.orange, 0),      linewidth = 1)

//--------------------------------------------------------------
// Markers: BUY / STRONG BUY / SELL / STRONG SELL
//--------------------------------------------------------------
plotshape(showMarkers and buySig  and not strongBuy,  "BUY",         style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.normal, textcolor = color.green, text = "BUY")
plotshape(showMarkers and strongBuy,                  "STRONG BUY",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.large,  textcolor = color.green, text = "STRONG BUY")
plotshape(showMarkers and sellSig and not strongSell, "SELL",        style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.normal, textcolor = color.red, text = "SELL")
plotshape(showMarkers and strongSell,                 "STRONG SELL", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.large,  textcolor = color.red, text = "STRONG SELL")

//--------------------------------------------------------------
// Last-signal state (levels + panel)
//--------------------------------------------------------------
var line  lnEntry = na
var line  lnSL    = na
var line  lnTP1   = na
var line  lnTP2   = na
var label lblEntry = na
var label lblSL    = na
var label lblTP1   = na
var label lblTP2   = na
var label lblSig    = na
var int   lastSigType = 0       // 2 STRONG BUY, 1 BUY, -1 SELL, -2 STRONG SELL, 0 none
var int   lastScore   = 0
var int   lastMax     = 0
var float lastEntry   = na
var float lastSL      = na
var float lastTP1     = na
var float lastTP2     = na
var float lastRisk    = na
var float lastRiskAtr = na
var float lastRR1     = na
var float lastRR2     = na
var float lastSigHigh = na
var float lastSigLow  = na
var int   lastSigBar  = na

//--- Audit snapshots (set ONLY at signal time; presentation/debug only)
var float  audEma50      = na
var float  audEma200     = na
var float  audEma50Prev  = na
var float  audEmaF       = na
var float  audEmaS       = na
var float  audAdx        = na
var float  audAdxMin     = na
var bool   audTrendOk    = false
var bool   audH1Ok       = false
var bool   audSlopeOk    = false
var bool   audCrossOk    = false
var bool   audAdxOk      = false
var bool   audVolOk      = false
var bool   audVolConfOk  = false
var int    audTrendPts   = 0
var int    audH1Pts      = 0
var int    audSlopePts   = 0
var int    audAdxPts     = 0
var int    audVolPts     = 0
var int    audVolConfPts = 0
var float  audH1Fast     = na
var float  audH1Slow     = na
var int    audBarTime    = na
var float  audStructSL   = na
var float  audRisk       = na
var float  audRiskAtr    = na
var float  audRR1        = na
var float  audRR2        = na
var string audSlMode     = ""

//--------------------------------------------------------------
// On a new confirmed BUY / STRONG BUY: remember + redraw levels
//--------------------------------------------------------------
if buySig
    lastSigType := strongBuy ? 2 : 1
    lastScore   := buyScore
    lastMax     := maxScore
    lastEntry   := entry
    lastSL      := slBuy
    lastTP1     := tp1Buy
    lastTP2     := tp2Buy
    lastRisk    := riskBuy
    lastRiskAtr := riskAtrBuy
    lastRR1     := rrTp1Buy
    lastRR2     := rrTp2Buy
    lastSigHigh := high
    lastSigLow  := low
    lastSigBar  := bar_index

    //--- Audit snapshots: exact values/conditions that produced this signal
    audEma50     := h4e50
    audEma200    := h4e200
    audEma50Prev := h4e50Prev
    audEmaF      := emaF
    audEmaS      := emaS
    audAdx       := adxVal
    audAdxMin    := adxMin
    audTrendOk   := h4Bull
    audH1Ok      := h1ConfUp
    audSlopeOk   := slopeUp
    audCrossOk   := crossUp
    audAdxOk     := adxPass
    audVolOk     := volOk
    audVolConfOk := volConfOk
    audTrendPts  := h4Bull     ? trendWeight : 0
    audH1Pts     := h1ConfUp   ? momWeight   : 0
    audSlopePts  := slopeUp    ? slopeWeight : 0
    audAdxPts    := adxPass    ? adxWeight   : 0
    audVolPts    := volOk      ? atrVolWeight : 0
    audVolConfPts := volConfOk ? volWeight   : 0
    audH1Fast    := h1FastV
    audH1Slow    := h1SlowV
    audBarTime   := time
    audStructSL  := structSLBuy
    audRisk      := riskBuy
    audRiskAtr   := riskAtrBuy
    audRR1       := rrTp1Buy
    audRR2       := rrTp2Buy
    audSlMode    := slModeBuy ? "STRUCTURAL" : "ATR FALLBACK"

    //--- Remove the previous signal's levels (na-safe: a signal may
    //--- have fired while showLevels was off, leaving na ids)
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lblEntry)
        label.delete(lblEntry)
    if not na(lblSL)
        label.delete(lblSL)
    if not na(lblTP1)
        label.delete(lblTP1)
    if not na(lblTP2)
        label.delete(lblTP2)
    if not na(lblSig)
        label.delete(lblSig)

    if showLevels
        lnEntry := line.new(bar_index, entry,  bar_index, entry,  extend = extend.right, color = color.new(color.white, 0), style = line.style_dotted, width = 2)
        lnSL    := line.new(bar_index, slBuy,  bar_index, slBuy,  extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 2)
        lnTP1   := line.new(bar_index, tp1Buy, bar_index, tp1Buy, extend = extend.right, color = color.new(color.green, 0), style = line.style_dotted, width = 1)
        lnTP2   := line.new(bar_index, tp2Buy, bar_index, tp2Buy, extend = extend.right, color = color.new(color.green, 0), style = line.style_dotted, width = 1)

        lblEntry := label.new(bar_index, entry,  "ENTRY " + str.tostring(entry,  format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.white, size = size.small)
        lblSL    := label.new(bar_index, slBuy,  "SL "    + str.tostring(slBuy,   format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,   size = size.small)
        lblTP1   := label.new(bar_index, tp1Buy, "TP1 "   + str.tostring(tp1Buy,  format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.small)
        lblTP2   := label.new(bar_index, tp2Buy, "TP2 "   + str.tostring(tp2Buy,  format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.small)

    if showSigLabels
        lblSig := label.new(bar_index, high, "Score " + str.tostring(buyScore), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.small)

//--------------------------------------------------------------
// On a new confirmed SELL / STRONG SELL: remember + redraw levels
//--------------------------------------------------------------
if sellSig
    lastSigType := strongSell ? -2 : -1
    lastScore   := sellScore
    lastMax     := maxScore
    lastEntry   := entry
    lastSL      := slSell
    lastTP1     := tp1Sell
    lastTP2     := tp2Sell
    lastRisk    := riskSell
    lastRiskAtr := riskAtrSell
    lastRR1     := rrTp1Sell
    lastRR2     := rrTp2Sell
    lastSigHigh := high
    lastSigLow  := low
    lastSigBar  := bar_index

    //--- Audit snapshots: exact values/conditions that produced this signal
    audEma50     := h4e50
    audEma200    := h4e200
    audEma50Prev := h4e50Prev
    audEmaF      := emaF
    audEmaS      := emaS
    audAdx       := adxVal
    audAdxMin    := adxMin
    audTrendOk   := h4Bear
    audH1Ok      := h1ConfDn
    audSlopeOk   := slopeDn
    audCrossOk   := crossDn
    audAdxOk     := adxPass
    audVolOk     := volOk
    audVolConfOk := volConfOk
    audTrendPts  := h4Bear     ? trendWeight : 0
    audH1Pts     := h1ConfDn   ? momWeight   : 0
    audSlopePts  := slopeDn    ? slopeWeight : 0
    audAdxPts    := adxPass    ? adxWeight   : 0
    audVolPts    := volOk      ? atrVolWeight : 0
    audVolConfPts := volConfOk ? volWeight   : 0
    audH1Fast    := h1FastV
    audH1Slow    := h1SlowV
    audBarTime   := time
    audStructSL  := structSLSell
    audRisk      := riskSell
    audRiskAtr   := riskAtrSell
    audRR1       := rrTp1Sell
    audRR2       := rrTp2Sell
    audSlMode    := slModeSell ? "STRUCTURAL" : "ATR FALLBACK"

    //--- Remove the previous signal's levels (na-safe)
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lblEntry)
        label.delete(lblEntry)
    if not na(lblSL)
        label.delete(lblSL)
    if not na(lblTP1)
        label.delete(lblTP1)
    if not na(lblTP2)
        label.delete(lblTP2)
    if not na(lblSig)
        label.delete(lblSig)

    if showLevels
        lnEntry := line.new(bar_index, entry,   bar_index, entry,   extend = extend.right, color = color.new(color.white, 0), style = line.style_dotted, width = 2)
        lnSL    := line.new(bar_index, slSell,  bar_index, slSell,  extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 2)
        lnTP1   := line.new(bar_index, tp1Sell, bar_index, tp1Sell, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 1)
        lnTP2   := line.new(bar_index, tp2Sell, bar_index, tp2Sell, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 1)

        lblEntry := label.new(bar_index, entry,   "ENTRY " + str.tostring(entry,   format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.white, size = size.small)
        lblSL    := label.new(bar_index, slSell,  "SL "    + str.tostring(slSell,  format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,   size = size.small)
        lblTP1   := label.new(bar_index, tp1Sell, "TP1 "   + str.tostring(tp1Sell, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red, size = size.small)
        lblTP2   := label.new(bar_index, tp2Sell, "TP2 "   + str.tostring(tp2Sell, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,  size = size.small)

    if showSigLabels
        lblSig := label.new(bar_index, low, "Score " + str.tostring(sellScore), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red, size = size.small)

//--------------------------------------------------------------
// Live toggle of the level lines (showLevels changed)
//--------------------------------------------------------------
var bool prevShowLevels = na
if na(prevShowLevels)
    prevShowLevels := showLevels
else if showLevels != prevShowLevels
    prevShowLevels := showLevels
    if not showLevels
        if not na(lnEntry)
            line.delete(lnEntry)
            lnEntry := na
        if not na(lnSL)
            line.delete(lnSL)
            lnSL := na
        if not na(lnTP1)
            line.delete(lnTP1)
            lnTP1 := na
        if not na(lnTP2)
            line.delete(lnTP2)
            lnTP2 := na
        if not na(lblEntry)
            label.delete(lblEntry)
            lblEntry := na
        if not na(lblSL)
            label.delete(lblSL)
            lblSL := na
        if not na(lblTP1)
            label.delete(lblTP1)
            lblTP1 := na
        if not na(lblTP2)
            label.delete(lblTP2)
            lblTP2 := na
    else
        if not na(lastSigBar)
            lnEntry := line.new(lastSigBar, lastEntry,  lastSigBar, lastEntry,  extend = extend.right, color = color.new(color.white, 0), style = line.style_dotted, width = 2)
            lnSL    := line.new(lastSigBar, lastSL,     lastSigBar, lastSL,     extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 2)
            lnTP1   := line.new(lastSigBar, lastTP1,    lastSigBar, lastTP1,    extend = extend.right, color = color.new(lastSigType > 0 ? color.green : color.red, 0), style = line.style_dotted, width = 1)
            lnTP2   := line.new(lastSigBar, lastTP2,    lastSigBar, lastTP2,    extend = extend.right, color = color.new(lastSigType > 0 ? color.green : color.red, 0), style = line.style_dotted, width = 1)

            lblEntry := label.new(lastSigBar, lastEntry,  "ENTRY " + str.tostring(lastEntry,  format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.white, size = size.small)
            lblSL    := label.new(lastSigBar, lastSL,     "SL "    + str.tostring(lastSL,     format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,   size = size.small)
            lblTP1   := label.new(lastSigBar, lastTP1,    "TP1 "   + str.tostring(lastTP1,    format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = lastSigType > 0 ? color.green : color.red, size = size.small)
            lblTP2   := label.new(lastSigBar, lastTP2,    "TP2 "   + str.tostring(lastTP2,    format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = lastSigType > 0 ? color.green : color.red, size = size.small)

//--------------------------------------------------------------
// Live toggle of the score label (showSigLabels changed)
//--------------------------------------------------------------
var bool prevShowSigLabels = na
if na(prevShowSigLabels)
    prevShowSigLabels := showSigLabels
else if showSigLabels != prevShowSigLabels
    prevShowSigLabels := showSigLabels
    if not showSigLabels
        if not na(lblSig)
            label.delete(lblSig)
            lblSig := na
    else
        if not na(lastSigBar)
            lblSig := label.new(lastSigBar, lastSigType > 0 ? lastSigHigh : lastSigLow, "Score " + str.tostring(lastScore), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = lastSigType > 0 ? color.green : color.red, size = size.small)

//--------------------------------------------------------------
// Alerts (once per confirmed signal, live bars only)
//--------------------------------------------------------------
if enableAlerts and buySig
    sigTxtAlert = strongBuy ? "STRONG BUY" : "BUY"
    alert(syminfo.ticker + " " + timeframe.period + ": " + sigTxtAlert +
          " | Score: " + str.tostring(buyScore) + "/" + str.tostring(maxScore) +
          " | Entry: " + str.tostring(entry, format.mintick) +
          " | SL: " + str.tostring(slBuy, format.mintick) +
          " | TP1: " + str.tostring(tp1Buy, format.mintick) +
          " | TP2: " + str.tostring(tp2Buy, format.mintick),
          alert.freq_once_per_bar_close)

if enableAlerts and sellSig
    sigTxtAlert = strongSell ? "STRONG SELL" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + ": " + sigTxtAlert +
          " | Score: " + str.tostring(sellScore) + "/" + str.tostring(maxScore) +
          " | Entry: " + str.tostring(entry, format.mintick) +
          " | SL: " + str.tostring(slSell, format.mintick) +
          " | TP1: " + str.tostring(tp1Sell, format.mintick) +
          " | TP2: " + str.tostring(tp2Sell, format.mintick),
          alert.freq_once_per_bar_close)

//--- Classic alert conditions (usable from the Alerts dialog)
alertcondition(strongBuy,                  title = "CanvasV STRONG BUY",  message = "CanvasV STRONG BUY signal")
alertcondition(buySig and not strongBuy,   title = "CanvasV BUY",         message = "CanvasV BUY signal")
alertcondition(strongSell,                 title = "CanvasV STRONG SELL", message = "CanvasV STRONG SELL signal")
alertcondition(sellSig and not strongSell, title = "CanvasV SELL",        message = "CanvasV SELL signal")

//--------------------------------------------------------------
// Info panel (upper-right)
//--------------------------------------------------------------
// MARKET section  : state as of the last CLOSED bar (confirmed).
//                   In self mode (chart TF >= H4) the trend is read
//                   with [1] so it is never the forming bar.
// LAST SIGNAL     : the frozen state of the latest confirmed signal.
//--------------------------------------------------------------
panelE50  = isH4chart ? h4e50[1]  : h4e50
panelE50Prev = isH4chart ? h4e50[2] : h4e50PrevH
panelE200 = isH4chart ? h4e200[1] : h4e200
panelH1Fast = isH1chart ? h1FastS[1] : h1FastH
panelH1Slow = isH1chart ? h1SlowS[1] : h1SlowH

//--- Position-level colors: entry neutral, SL red, TP directional
//--- (green for a BUY position, red for a SELL position).
tpCol   = lastSigType > 0 ? color.green : lastSigType < 0 ? color.red : color.silver
//--- 1H state (stable, confirmed values) - used by the footer below
h1MomTxt = panelH1Fast > panelH1Slow ? "BULLISH" : panelH1Fast < panelH1Slow ? "BEARISH" : "NEUTRAL"
//--- Compact context footer: TF role + 1H state + ADX. The status /
//--- reason text only turns red when it actually matters (blocked
//--- timeframe or config error) - no blank rows on supported charts.
ctxTxt  = not isSupportedSignalTF ? str.tostring(timeframe.period) + " · SIGNALS DISABLED · " + tfReasonTxt : configOk ? tfRoleTxt + " · 1H " + h1MomTxt + " · ADX " + str.tostring(adxVal[1], "#.##") : tfRoleTxt + " · CONFIG " + cfgReason
ctxCol  = not isSupportedSignalTF or not configOk ? color.red : color.silver
statTxt = isSupportedSignalTF ? "ENABLED" : "DISABLED"
statCol = isSupportedSignalTF ? color.green : color.red
//--- Regime shown in the panel (stable values: previous closed 4H on the
//--- 4H chart, last closed 4H elsewhere). NEUTRAL when the slope is flat
//--- or the separation is below the minimum.
panelSepOk = math.abs(panelE50 - panelE200) / math.max(panelE200, 1e-10) * 100 >= min4hSep
panelRegUp = panelE50 > panelE200 and panelE50 > panelE50Prev and panelSepOk
panelRegDn = panelE50 < panelE200 and panelE50 < panelE50Prev and panelSepOk
trendTxt = panelRegUp ? "BULLISH" : panelRegDn ? "BEARISH" : "NEUTRAL"

sigTxt = lastSigType == 2 ? "STRONG BUY" : lastSigType == 1 ? "BUY" :
         lastSigType == -1 ? "SELL" : lastSigType == -2 ? "STRONG SELL" : "NONE"

sigColor   = lastSigType > 0 ? color.green : lastSigType < 0 ? color.red : color.silver
trendColor = trendTxt == "BULLISH" ? color.green : trendTxt == "BEARISH" ? color.red : color.silver

var table pan = na

if showPanel
    if na(pan)
        pan := table.new(position.top_right, 2, 11, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))

    //--- Title
    table.cell(pan, 0, 0, "CANVASV MTF SIGNAL", text_color = color.white,  text_size = size.normal)
    table.cell(pan, 1, 0, VERSION,              text_color = color.silver, text_size = size.small)
    //--- Trend (dominant context)
    table.cell(pan, 0, 1, "TREND", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 1, trendTxt, text_color = trendColor, text_size = size.normal)
    //--- Signal (visually dominant)
    table.cell(pan, 0, 2, "SIGNAL", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 2, sigTxt, text_color = sigColor, text_size = size.large)
    //--- Score (neutral - information, not a separate visual state)
    table.cell(pan, 0, 3, "SCORE", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 3, na(lastSigBar) ? "—" : str.tostring(lastScore) + "/" + str.tostring(lastMax), text_color = color.silver, text_size = size.normal)
    //--- Position levels
    table.cell(pan, 0, 4, "ENTRY", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 4, na(lastEntry) ? "--" : str.tostring(lastEntry, format.mintick), text_color = color.white, text_size = size.normal)
    table.cell(pan, 0, 5, "SL", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 5, na(lastSL) ? "--" : str.tostring(lastSL, format.mintick), text_color = color.red, text_size = size.normal)
    table.cell(pan, 0, 6, "TP1", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 6, na(lastTP1) ? "--" : str.tostring(lastTP1, format.mintick), text_color = tpCol, text_size = size.normal)
    table.cell(pan, 0, 7, "TP2", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 7, na(lastTP2) ? "--" : str.tostring(lastTP2, format.mintick), text_color = tpCol, text_size = size.normal)
    table.cell(pan, 0, 8, "RISK", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 8, na(lastRiskAtr) ? "--" : str.tostring(lastRiskAtr, "#.##") + " ATR", text_color = color.white, text_size = size.normal)
    table.cell(pan, 0, 9, "R:R", text_color = color.silver, text_size = size.small)
    table.cell(pan, 1, 9, na(lastRR1) ? "--" : str.tostring(lastRR1, "#.##") + " / " + str.tostring(lastRR2, "#.##"), text_color = color.white, text_size = size.normal)
    //--- Compact context footer (TF role · 1H state · ADX) with the
    //--- status; reason only appears when it matters (blocked TF /
    //--- config error), so no blank rows are wasted on normal charts.
    table.cell(pan, 0, 10, ctxTxt, text_color = ctxCol, text_size = size.small)
    table.cell(pan, 1, 10, statTxt, text_color = statCol, text_size = size.small)
else
    if not na(pan)
        table.delete(pan)
        pan := na

//--------------------------------------------------------------
// Signal Audit table (Signal Audit Mode = true)
// Debug/diagnostic only: shows the EXACT snapshotted values and
// conditions that produced the latest confirmed signal. When the
// mode is off this block is inactive and the chart is unchanged.
//--------------------------------------------------------------
audDirTxt   = lastSigType == 2 ? "STRONG BUY" : lastSigType == 1 ? "BUY" :
              lastSigType == -1 ? "SELL" : lastSigType == -2 ? "STRONG SELL" : "NONE"
audSigCol   = lastSigType > 0 ? color.green : lastSigType < 0 ? color.red : color.silver
audHas      = not na(lastSigBar)
audScoreTxt = audHas ? str.tostring(lastScore) + " / " + str.tostring(lastMax) : "—"

//--- Pass/fail text per component (exact snapshotted contributions)
audTrendTxt   = audHas ? (audTrendOk   ? "✓ PASS  +" + str.tostring(audTrendPts)   : "✗ FAIL  +" + str.tostring(audTrendPts))   : "—"
audH1Txt      = audHas ? (audH1Ok      ? "✓ PASS  +" + str.tostring(audH1Pts)      : "✗ FAIL  +" + str.tostring(audH1Pts))      : "—"
audSlopeTxt   = audHas ? (audSlopeOk   ? "✓ PASS  +" + str.tostring(audSlopePts)   : "✗ FAIL  +" + str.tostring(audSlopePts))   : "—"
audCrossTxt   = audHas ? (audCrossOk   ? "✓ PASS" : "✗ FAIL") : "—"
audAdxTxt     = audHas ? (audAdxOk     ? "✓ PASS  +" + str.tostring(audAdxPts)     : "✗ FAIL  +" + str.tostring(audAdxPts))     : "—"
audVolTxt     = audHas ? (audVolOk     ? "✓ PASS  +" + str.tostring(audVolPts)     : "✗ FAIL  +" + str.tostring(audVolPts))     : "—"
audVolConfTxt = audHas ? (audVolConfOk ? "✓ PASS  +" + str.tostring(audVolConfPts) : "✗ FAIL  +" + str.tostring(audVolConfPts)) : "—"

slopeDirTxt = audHas ? (audEma50 > audEma50Prev ? "rising" : audEma50 < audEma50Prev ? "falling" : "flat") : ""

//--- Timeframe-policy display for the audit table
signalTfTxt     = isM15 ? "15M" : isH1chart ? "1H" : isH4chart ? "4H" : str.tostring(timeframe.period)
entryTfTxt      = isM15 ? "M15 ENTRY" : isH1chart ? "1H ENTRY" : isH4chart ? "4H ENTRY" : "ENTRY"
audModeTxt      = isSupportedSignalTF ? "ENABLED" : "DISABLED"
audModeCol      = isSupportedSignalTF ? color.green : color.red
audConfirmedTxt = isSupportedSignalTF ? "YES - closed candle" : "NO - signals disabled"

//--- Rejection reason (audit only): for a fresh confirmed crossover on a
//--- supported timeframe whose setup was rejected, show the FIRST failed
//--- gate in pipeline order. Empty when no candidate was rejected.
var string rejectTxt = ""
rejectTxt := ""
isCandidateUp = isConfirmed and configOk and isSupportedSignalTF and crossUp
isCandidateDn = isConfirmed and configOk and isSupportedSignalTF and crossDn
if isCandidateUp
    rejectTxt := not regimeUpOk ? "4H REGIME" : not h1ConfUp ? "1H CONFIRMATION" : not h1MomUp ? "1H MOMENTUM" : not setupGateUp ? "ENTRY STRUCTURE" : not candleUpOk ? "CANDLE QUALITY" : not adxGateOk ? "ADX" : not volFloorOk ? "VOLATILITY" : not chaseGateOk ? "CHASING" : not buyGate ? "OPTIONAL FILTERS" : not atrUsable ? "ATR INVALID" : buyScore < minScore ? "SCORE TOO LOW" : not riskGateBuyOk ? (riskAtrBuy > maxRiskAtr ? "RISK TOO LARGE" : "INVALID STRUCTURE") : ""
if isCandidateDn
    rejectTxt := not regimeDnOk ? "4H REGIME" : not h1ConfDn ? "1H CONFIRMATION" : not h1MomDn ? "1H MOMENTUM" : not setupGateDn ? "ENTRY STRUCTURE" : not candleDnOk ? "CANDLE QUALITY" : not adxGateOk ? "ADX" : not volFloorOk ? "VOLATILITY" : not chaseGateOk ? "CHASING" : not sellGate ? "OPTIONAL FILTERS" : not atrUsable ? "ATR INVALID" : sellScore < minScore ? "SCORE TOO LOW" : not riskGateSellOk ? (riskAtrSell > maxRiskAtr ? "RISK TOO LARGE" : "INVALID STRUCTURE") : ""

//==============================================================
// SIGNAL DECISION LOGGER (v3.3.0) - observational only
//  Signal Decision Logger OFF : zero activity; chart and engine are
//    byte-identical to v3.2.0. No labels, no tables, no alerts.
//  Diagnostic Mode ON  : every confirmed candidate evaluation on
//    a supported timeframe (15m/1H/4H) is logged with the EXACT
//    values the engine used; the first failed gate is recorded;
//    accepted signals are tracked for MFE/MAE (in R), TP/SL hits
//    and outcome classification. This layer never feeds back into
//    the signal decision - pure data collection.
//  Pine limitation: Pine cannot write files to disk, so the log
//    lives in bounded arrays (most recent N events) shown in a
//    table, plus optional CVLOG alerts; export is copy-paste.
//==============================================================
//--- Event history buffer (bounded, newest at the end)
var array<int>    evTime   = array.new_int()
var array<string> evTf     = array.new_string()
var array<string> evDir    = array.new_string()
var array<string> evResult = array.new_string()
var array<int>    evScore  = array.new_int()
var array<string> evReason = array.new_string()
var array<float>  evEntry  = array.new_float()
var array<float>  evRiskA  = array.new_float()
var array<float>  evRR1    = array.new_float()
var array<float>  evRR2    = array.new_float()

//--- Latest-event detail snapshot (exact engine values, frozen)
var int    devTime     = na
var string devTf       = ""
var string devDir      = ""
var string devResult   = ""
var string devReason   = ""
var string devSigType  = ""
var int    devScore    = 0
var int    devMax      = 0
var int    devMin      = 0
var float  devE50      = na
var float  devE200     = na
var float  devSep      = na
var float  devE50Prev  = na
var string devSlope    = ""
var bool   devRegimeOk = false
var float  devH1Fast   = na
var float  devH1Slow   = na
var float  devH1Close  = na
var string devH1       = ""
var float  devEmaF     = na
var float  devEmaS     = na
var float  devGap      = na
var float  devGapPrev  = na
var string devEntry    = ""
var string devCandle   = ""
var float  devAdx      = na
var float  devAdxMin   = na
var string devQual     = ""
var float  devAtr      = na
var float  devAtrPct   = na
var float  devDistAtr  = na
var string devScoreBrk = ""
var float  devEntryPx  = na
var float  devSL       = na
var float  devTP1      = na
var float  devTP2      = na
var float  devRisk     = na
var float  devRiskAtr  = na
var float  devRR1      = na
var float  devRR2      = na
var string devDecision = ""
var bool   devGateSlope = false
var bool   devGateSep   = false
var bool   devGateH1Struct = false
var bool   devGateH1Mom = false
var bool   devGateEntryStruct = false
var bool   devGateEntryPos = false
var bool   devGateEmaExp = false
var bool   devGateTrigger = false
var bool   devGateCandle = false
var bool   devGateAdx   = false
var bool   devGateVol   = false
var bool   devGateChase = false
var bool   devGateRisk  = false
var bool   devGateScore = false
//--- Phase 4A context snapshot (set with every logged event)
var float  devH4SlopePct = na
var float  devH4DistAtr  = na
var float  devAtrVsAvg   = na
var string devAtrRegime  = ""
var int    devH1Age      = 0
var int    devH1AgeMin   = 0
var int    devSinceSig   = na

//--- Active-signal outcome tracking (one at a time; observational)
var bool   trActive  = false
var int    trBar     = na
var int    trTime    = na
var string trDir     = ""
var float  trEntry   = na
var float  trSL      = na
var float  trTP1     = na
var float  trTP2     = na
var float  trRisk    = na
var int    trElapsed = 0
var float  trMFE     = 0.0
var float  trMAE     = 0.0
var float  trFinalR  = na
var bool   trSlHit   = false
var bool   trTp1Hit  = false
var bool   trTp2Hit  = false
var string trOutcome = ""
var array<string> outLog = array.new_string()

//--- Decision statistics (counted from logged candidates)
var int stCand = 0
var int stSig = 0
var int stRej = 0
var int st4hRegime = 0
var int st4hSlope = 0
var int st4hSep = 0
var int st1hStruct = 0
var int st1hMom = 0
var int stEntryStruct = 0
var int stEntryPos = 0
var int stEmaExp = 0
var int stCandle = 0
var int stAdx = 0
var int stVol = 0
var int stChase = 0
var int stOpt = 0
var int stRisk = 0
var int stScore = 0

//==============================================================
// PHASE 4A OBSERVABILITY MEASUREMENTS (v3.4.1, extended v3.4.2) - observation only
//  New diagnostic fields capture market CONTEXT around candidates
//  and signal resolution. NONE of these values feed back into any
//  gate, score, or signal - pure data collection for the BTCUSD
//  15M study. No new request.security calls are used; every input
//  below is the engine's existing confirmed series.
//==============================================================
//--- 4.1 H4 slope magnitude: % change of the previous confirmed
//--- H4 EMA50 (same series the strict slope gate uses; measurement)
h4SlopePct = (h4e50 - h4e50Prev) / math.max(h4e50Prev, 1e-10) * 100
//--- 4.2 H4 EMA50/EMA200 separation magnitude (% of EMA200) - same
//--- formula the 0.10% regime gate uses; measurement only
h4SepPct   = math.abs(h4e50 - h4e200) / math.max(h4e200, 1e-10) * 100
//--- 4.3 Price distance from the 4H EMA50 at the entry, in ATR units
//--- (diagnostic only; NOT a rejection rule)
h4EmaDistAtr = math.abs(entry - h4e50) / math.max(atrVal, 1e-10)
//--- 4.4 ATR volatility regime: current ATR vs its own N-bar SMA.
//--- TRANSPARENT RATIO (not a true percentile): ATR as a % of its
//--- average over the window. Regime bands: <80% LOW, 80-120%
//--- NORMAL, 120-160% HIGH, >=160% EXTREME. Uses only historical
//--- bars (ta.sma), no future data, no repaint. Diagnostic only.
atrHistLen  = input.int(200, "ATR regime lookback (diagnostic)", minval = 20, maxval = 1000, group = grpDiag)
atrAvg      = ta.sma(atrVal, atrHistLen)
atrVsAvg    = atrVal / math.max(atrAvg, 1e-10) * 100
atrRegimeTxt = atrVsAvg < 80 ? "LOW" : atrVsAvg < 120 ? "NORMAL" : atrVsAvg < 160 ? "HIGH" : "EXTREME"
//--- 4.5 1H confirmation freshness: entry-TF bars since the last 1H
//--- confirmation-state change (0 = the 1H just updated; on a 15m
//--- chart this cycles 0-3 per 1H candle). Uses the SAME confirmed
//--- 1H series the gates use (h1FastV/h1SlowV) - never the forming
//--- 1H candle. Documented ambiguity: "state change" = the last bar
//--- on which the confirmed 1H EMA21-vs-EMA50 state updated.
var int    h1AgeBars = 0
var string h1AgeDir  = "FLAT"
h1DirNow  = h1FastV > h1SlowV ? "UP" : h1FastV < h1SlowV ? "DN" : "FLAT"
if h1DirNow != h1AgeDir
    h1AgeDir := h1DirNow
    h1AgeBars := 0
else
    h1AgeBars := h1AgeBars + 1
h1AgeMin  = h1AgeBars * tfSec / 60
//--- 4.6 Bars since the previous accepted signal (logger session only)
var int prevSigBar = na
//--- 4.7/4.8 Resolution-context snapshot (set at the resolution candle;
//--- strictly post-hoc, never feeds back into the signal decision)
var string resH4    = ""
var string resH1    = ""
var string resAdx   = ""
var string resAlign = ""
var int    resBars  = 0
var int    resTime  = na
//--- Aggregate accumulators for the extended DIAGNOSTIC STATS table
var float stSumScore = 0.0
var float stSumSlope = 0.0
var float stSumSep   = 0.0
var float stSumDist  = 0.0
var float stSumAtr   = 0.0
var float stSumAge   = 0.0
var float stSumRes   = 0.0
var int   stResCnt   = 0
var int   stOutSl  = 0
var int   stOutTp1 = 0
var int   stOutTp2 = 0
var int   stOutAmb = 0
var int   stOutExp = 0
var int   stOutSup = 0

//--- Granular first-failed-gate reason, derived ONLY from the
//--- existing gate booleans (observation, not a reimplementation)
diagReasonUp = not regimeUpOk ? (not h4Bull ? "4H REGIME" : not slopeUp ? "4H SLOPE" : "4H SEPARATION") : not h1ConfUp ? "1H STRUCTURE" : not h1MomUp ? "1H MOMENTUM" : not setupGateUp ? (not (emaF > emaS) ? "ENTRY STRUCTURE" : not (close >= emaF) ? "ENTRY POSITION" : "EMA EXPANSION") : not crossUp ? "NO TRIGGER" : not candleUpOk ? (close <= open ? "CANDLE DIRECTION" : "CANDLE BODY") : not adxGateOk ? "ADX" : not volFloorOk ? "VOLATILITY" : not chaseGateOk ? "CHASING" : not buyGate ? "OPTIONAL FILTERS" : not atrUsable ? "ATR INVALID" : buyScore < minScore ? "SCORE" : not riskGateBuyOk ? (riskAtrBuy > maxRiskAtr ? "RISK TOO LARGE" : "INVALID STRUCTURE") : ""
diagReasonDn = not regimeDnOk ? (not h4Bear ? "4H REGIME" : not slopeDn ? "4H SLOPE" : "4H SEPARATION") : not h1ConfDn ? "1H STRUCTURE" : not h1MomDn ? "1H MOMENTUM" : not setupGateDn ? (not (emaF < emaS) ? "ENTRY STRUCTURE" : not (close <= emaF) ? "ENTRY POSITION" : "EMA EXPANSION") : not crossDn ? "NO TRIGGER" : not candleDnOk ? (close >= open ? "CANDLE DIRECTION" : "CANDLE BODY") : not adxGateOk ? "ADX" : not volFloorOk ? "VOLATILITY" : not chaseGateOk ? "CHASING" : not sellGate ? "OPTIONAL FILTERS" : not atrUsable ? "ATR INVALID" : sellScore < minScore ? "SCORE" : not riskGateSellOk ? (riskAtrSell > maxRiskAtr ? "RISK TOO LARGE" : "INVALID STRUCTURE") : ""

//--- Capture BUY candidate events (confirmed, supported TF only)
if decisionLogger and isCandidateUp
    devTime     := time
    devTf       := timeframe.period
    devDir      := "BUY"
    devResult   := buySig ? "SIGNAL" : "REJECTED"
    devReason   := buySig ? "" : diagReasonUp
    devSigType  := strongBuy ? "STRONG BUY" : "BUY"
    devScore    := buyScore
    devMax      := maxScore
    devMin      := minScore
    devE50      := h4e50
    devE200     := h4e200
    devSep      := math.abs(h4e50 - h4e200) / math.max(h4e200, 1e-10) * 100
    devE50Prev  := h4e50Prev
    devSlope    := slopeUp ? "RISING" : slopeDn ? "FALLING" : "FLAT"
    devRegimeOk := regimeUpOk
    devH1Fast   := h1FastV
    devH1Slow   := h1SlowV
    devH1Close  := h1CloseV
    devH1       := (h1ConfUp ? "STRUCT PASS" : "STRUCT FAIL") + " · " + (h1MomUp ? "MOM PASS" : "MOM FAIL")
    devEmaF     := emaF
    devEmaS     := emaS
    devGap      := gapUp
    devGapPrev  := gapUp[1]
    devEntry    := (setupUp ? "STRUCT PASS" : "STRUCT FAIL") + " · " + (gapUpExp ? "GAP EXP PASS (" + str.tostring(gapUp[1], "#.##") + "→" + str.tostring(gapUp, "#.##") + ")" : "GAP EXP FAIL")
    devCandle   := (close > open ? "UP" : "DN") + " · BODY " + str.tostring(candleBodyPct, "#.#") + "% · RANGE " + str.tostring(candleRange, format.mintick)
    devAdx      := adxVal
    devAdxMin   := adxMin
    devAtr      := atrVal
    devAtrPct   := atrPct
    devDistAtr  := entryDistAtr
    devQual     := (adxGateOk ? "ADX " + str.tostring(adxVal, "#.##") + " ✓" : "ADX " + str.tostring(adxVal, "#.##") + " ✗") + " · " + (volFloorOk ? "ATR% " + str.tostring(atrPct, "#.##") + " ✓" : "ATR% ✗") + " · " + (chaseGateOk ? "CHASE " + str.tostring(entryDistAtr, "#.##") + "A ✓" : "CHASE " + str.tostring(entryDistAtr, "#.##") + "A ✗")
    devScoreBrk := "T" + str.tostring(h4Bull ? trendWeight : 0) + " H" + str.tostring(h1ConfUp ? momWeight : 0) + " A" + str.tostring(adxPass ? adxWeight : 0) + " S" + str.tostring(slopeUp ? slopeWeight : 0) + " V" + str.tostring(volOk ? atrVolWeight : 0) + " V" + str.tostring(volConfOk ? volWeight : 0)
    //--- Phase 4A context measurements (observation only)
    devH4SlopePct := h4SlopePct
    devH4DistAtr  := h4EmaDistAtr
    devAtrVsAvg   := atrVsAvg
    devAtrRegime  := atrRegimeTxt
    devH1Age      := h1AgeBars
    devH1AgeMin   := h1AgeMin
    devSinceSig   := na(prevSigBar) ? na : bar_index - prevSigBar
    devEntryPx  := entry
    devSL       := slBuy
    devTP1      := tp1Buy
    devTP2      := tp2Buy
    devRisk     := riskBuy
    devRiskAtr  := riskAtrBuy
    devRR1      := rrTp1Buy
    devRR2      := rrTp2Buy
    devDecision := buySig ? devSigType : "REJECTED"
    devGateSlope := slopeUp
    devGateSep   := sep4HOk
    devGateH1Struct := h1ConfUp
    devGateH1Mom := h1MomUp
    devGateEntryStruct := emaF > emaS
    devGateEntryPos := close >= emaF
    devGateEmaExp := gapUpExp
    devGateTrigger := crossUp
    devGateCandle := candleUpOk
    devGateAdx   := adxGateOk
    devGateVol   := volFloorOk
    devGateChase := chaseGateOk
    devGateRisk  := riskGateBuyOk
    devGateScore := buyScore >= minScore

    //--- Buffer push (bounded by the Diagnostic history size input)
    array.push(evTime,   time)
    array.push(evTf,     timeframe.period)
    array.push(evDir,    "BUY")
    array.push(evResult, devResult)
    array.push(evScore,  buyScore)
    array.push(evReason, devReason)
    array.push(evEntry,  entry)
    array.push(evRiskA,  riskAtrBuy)
    array.push(evRR1,    rrTp1Buy)
    array.push(evRR2,    rrTp2Buy)
    if array.size(evTime) > diagHistorySize
        array.remove(evTime, 0)
        array.remove(evTf, 0)
        array.remove(evDir, 0)
        array.remove(evResult, 0)
        array.remove(evScore, 0)
        array.remove(evReason, 0)
        array.remove(evEntry, 0)
        array.remove(evRiskA, 0)
        array.remove(evRR1, 0)
        array.remove(evRR2, 0)

    //--- Decision statistics (reason buckets from the existing chain)
    stCand := stCand + 1
    if buySig
        stSig := stSig + 1
    else
        stRej := stRej + 1
        if diagReasonUp == "4H REGIME"
            st4hRegime := st4hRegime + 1
        else if diagReasonUp == "4H SLOPE"
            st4hSlope := st4hSlope + 1
        else if diagReasonUp == "4H SEPARATION"
            st4hSep := st4hSep + 1
        else if diagReasonUp == "1H STRUCTURE"
            st1hStruct := st1hStruct + 1
        else if diagReasonUp == "1H MOMENTUM"
            st1hMom := st1hMom + 1
        else if diagReasonUp == "ENTRY STRUCTURE"
            stEntryStruct := stEntryStruct + 1
        else if diagReasonUp == "ENTRY POSITION"
            stEntryPos := stEntryPos + 1
        else if diagReasonUp == "EMA EXPANSION"
            stEmaExp := stEmaExp + 1
        else if diagReasonUp == "CANDLE DIRECTION" or diagReasonUp == "CANDLE BODY"
            stCandle := stCandle + 1
        else if diagReasonUp == "ADX"
            stAdx := stAdx + 1
        else if diagReasonUp == "VOLATILITY"
            stVol := stVol + 1
        else if diagReasonUp == "CHASING"
            stChase := stChase + 1
        else if diagReasonUp == "OPTIONAL FILTERS"
            stOpt := stOpt + 1
        else if diagReasonUp == "RISK TOO LARGE" or diagReasonUp == "INVALID STRUCTURE" or diagReasonUp == "ATR INVALID"
            stRisk := stRisk + 1
        else if diagReasonUp == "SCORE"
            stScore := stScore + 1

    //--- Phase 4A aggregate accumulators (candidate-level context)
    stSumScore := stSumScore + buyScore
    stSumSlope := stSumSlope + h4SlopePct
    stSumSep   := stSumSep + devSep
    stSumDist  := stSumDist + h4EmaDistAtr
    stSumAtr   := stSumAtr + atrVsAvg
    stSumAge   := stSumAge + h1AgeBars

    //--- A newer signal finalizes an older still-unresolved one
    if buySig and trActive
        trOutcome := "SUPERSEDED"
        trFinalR  := (close - trEntry) / math.max(trRisk, 1e-10)
        resH4     := h4Bull ? "BULLISH" : h4Bear ? "BEARISH" : "NEUTRAL"
        resH1     := h1FastV > h1SlowV ? "BULLISH" : h1FastV < h1SlowV ? "BEARISH" : "NEUTRAL"
        resAdx    := str.tostring(adxVal, "#.##")
        resBars   := trElapsed
        resTime   := time
        resAlign  := (trDir == "BUY" and h4Bull and h1ConfUp) or (trDir == "SELL" and h4Bear and h1ConfDn) ? "INTACT" : "BROKEN"
        stOutSup  := stOutSup + 1
        stResCnt  := stResCnt + 1
        stSumRes  := stSumRes + trElapsed
        array.push(outLog, str.tostring(trTime, "MM-dd HH:mm") + " " + trDir + " E" + str.tostring(trEntry, format.mintick) + " -> SUPERSEDED (" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m) H4 " + resH4 + " H1 " + resH1 + " ALIGN " + resAlign + " MFE +" + str.tostring(trMFE, "#.##") + "R MAE -" + str.tostring(trMAE, "#.##") + "R")
        if array.size(outLog) > 20
            array.remove(outLog, 0)
        //--- CVOUT alert: machine-readable resolution record (diagnostic only)
        if enableDiagAlerts
            alert("CVOUT|" + syminfo.ticker + "|" + timeframe.period + "|" + trDir + "|" + trOutcome + "|" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m|MFE=+" + str.tostring(trMFE, "#.##") + "R|MAE=-" + str.tostring(trMAE, "#.##") + "R|R=" + (na(trFinalR) ? "--" : str.tostring(trFinalR, "#.##")) + "|H4=" + resH4 + "|H1=" + resH1 + "|ALIGN=" + resAlign + "|E=" + str.tostring(trEntry, format.mintick) + "|SL=" + str.tostring(trSL, format.mintick) + "|TP1=" + str.tostring(trTP1, format.mintick) + "|TP2=" + str.tostring(trTP2, format.mintick) + "|T=" + str.tostring(trTime, "MM-dd HH:mm"), alert.freq_once_per_bar_close)
    if buySig
        prevSigBar := bar_index
        trActive  := true
        trBar     := bar_index
        trTime    := time
        trDir     := "BUY"
        trEntry   := entry
        trSL      := slBuy
        trTP1     := tp1Buy
        trTP2     := tp2Buy
        trRisk    := riskBuy
        trElapsed := 0
        trMFE     := 0.0
        trMAE     := 0.0
        trFinalR  := na
        trSlHit   := false
        trTp1Hit  := false
        trTp2Hit  := false
        trOutcome := "unresolved"

    //--- Optional CVLOG alert (separate from trading alerts; default off)
    if enableDiagAlerts
        alert("CVLOG|" + syminfo.ticker + "|" + timeframe.period + "|BUY|" + devResult + "|" + str.tostring(buyScore) + "|" + (devReason == "" ? "OK" : devReason) + "|ADX=" + str.tostring(adxVal, "#.##") + "|ATR=" + str.tostring(atrVal, "#.##") + "|RISK=" + str.tostring(riskAtrBuy, "#.##") + "A|RR=" + str.tostring(rrTp1Buy, "#.##") + "/" + str.tostring(rrTp2Buy, "#.##") + "|E=" + str.tostring(entry, format.mintick) + "|SL=" + str.tostring(slBuy, format.mintick) + "|TP1=" + str.tostring(tp1Buy, format.mintick) + "|TP2=" + str.tostring(tp2Buy, format.mintick) + "|T=" + str.tostring(time, "MM-dd HH:mm"), alert.freq_once_per_bar_close)

//--- Capture SELL candidate events (mirrored)
if decisionLogger and isCandidateDn
    devTime     := time
    devTf       := timeframe.period
    devDir      := "SELL"
    devResult   := sellSig ? "SIGNAL" : "REJECTED"
    devReason   := sellSig ? "" : diagReasonDn
    devSigType  := strongSell ? "STRONG SELL" : "SELL"
    devScore    := sellScore
    devMax      := maxScore
    devMin      := minScore
    devE50      := h4e50
    devE200     := h4e200
    devSep      := math.abs(h4e50 - h4e200) / math.max(h4e200, 1e-10) * 100
    devE50Prev  := h4e50Prev
    devSlope    := slopeUp ? "RISING" : slopeDn ? "FALLING" : "FLAT"
    devRegimeOk := regimeDnOk
    devH1Fast   := h1FastV
    devH1Slow   := h1SlowV
    devH1Close  := h1CloseV
    devH1       := (h1ConfDn ? "STRUCT PASS" : "STRUCT FAIL") + " · " + (h1MomDn ? "MOM PASS" : "MOM FAIL")
    devEmaF     := emaF
    devEmaS     := emaS
    devGap      := gapDn
    devGapPrev  := gapDn[1]
    devEntry    := (setupDn ? "STRUCT PASS" : "STRUCT FAIL") + " · " + (gapDnExp ? "GAP EXP PASS (" + str.tostring(gapDn[1], "#.##") + "→" + str.tostring(gapDn, "#.##") + ")" : "GAP EXP FAIL")
    devCandle   := (close < open ? "DN" : "UP") + " · BODY " + str.tostring(candleBodyPct, "#.#") + "% · RANGE " + str.tostring(candleRange, format.mintick)
    devAdx      := adxVal
    devAdxMin   := adxMin
    devAtr      := atrVal
    devAtrPct   := atrPct
    devDistAtr  := entryDistAtr
    devQual     := (adxGateOk ? "ADX " + str.tostring(adxVal, "#.##") + " ✓" : "ADX " + str.tostring(adxVal, "#.##") + " ✗") + " · " + (volFloorOk ? "ATR% " + str.tostring(atrPct, "#.##") + " ✓" : "ATR% ✗") + " · " + (chaseGateOk ? "CHASE " + str.tostring(entryDistAtr, "#.##") + "A ✓" : "CHASE " + str.tostring(entryDistAtr, "#.##") + "A ✗")
    devScoreBrk := "T" + str.tostring(h4Bear ? trendWeight : 0) + " H" + str.tostring(h1ConfDn ? momWeight : 0) + " A" + str.tostring(adxPass ? adxWeight : 0) + " S" + str.tostring(slopeDn ? slopeWeight : 0) + " V" + str.tostring(volOk ? atrVolWeight : 0) + " V" + str.tostring(volConfOk ? volWeight : 0)
    //--- Phase 4A context measurements (observation only)
    devH4SlopePct := h4SlopePct
    devH4DistAtr  := h4EmaDistAtr
    devAtrVsAvg   := atrVsAvg
    devAtrRegime  := atrRegimeTxt
    devH1Age      := h1AgeBars
    devH1AgeMin   := h1AgeMin
    devSinceSig   := na(prevSigBar) ? na : bar_index - prevSigBar
    devEntryPx  := entry
    devSL       := slSell
    devTP1      := tp1Sell
    devTP2      := tp2Sell
    devRisk     := riskSell
    devRiskAtr  := riskAtrSell
    devRR1      := rrTp1Sell
    devRR2      := rrTp2Sell
    devDecision := sellSig ? devSigType : "REJECTED"
    devGateSlope := slopeDn
    devGateSep   := sep4HOk
    devGateH1Struct := h1ConfDn
    devGateH1Mom := h1MomDn
    devGateEntryStruct := emaF < emaS
    devGateEntryPos := close <= emaF
    devGateEmaExp := gapDnExp
    devGateTrigger := crossDn
    devGateCandle := candleDnOk
    devGateAdx   := adxGateOk
    devGateVol   := volFloorOk
    devGateChase := chaseGateOk
    devGateRisk  := riskGateSellOk
    devGateScore := sellScore >= minScore

    //--- Buffer push (bounded)
    array.push(evTime,   time)
    array.push(evTf,     timeframe.period)
    array.push(evDir,    "SELL")
    array.push(evResult, devResult)
    array.push(evScore,  sellScore)
    array.push(evReason, devReason)
    array.push(evEntry,  entry)
    array.push(evRiskA,  riskAtrSell)
    array.push(evRR1,    rrTp1Sell)
    array.push(evRR2,    rrTp2Sell)
    if array.size(evTime) > diagHistorySize
        array.remove(evTime, 0)
        array.remove(evTf, 0)
        array.remove(evDir, 0)
        array.remove(evResult, 0)
        array.remove(evScore, 0)
        array.remove(evReason, 0)
        array.remove(evEntry, 0)
        array.remove(evRiskA, 0)
        array.remove(evRR1, 0)
        array.remove(evRR2, 0)

    //--- Decision statistics (reason buckets from the existing chain)
    stCand := stCand + 1
    if sellSig
        stSig := stSig + 1
    else
        stRej := stRej + 1
        if diagReasonDn == "4H REGIME"
            st4hRegime := st4hRegime + 1
        else if diagReasonDn == "4H SLOPE"
            st4hSlope := st4hSlope + 1
        else if diagReasonDn == "4H SEPARATION"
            st4hSep := st4hSep + 1
        else if diagReasonDn == "1H STRUCTURE"
            st1hStruct := st1hStruct + 1
        else if diagReasonDn == "1H MOMENTUM"
            st1hMom := st1hMom + 1
        else if diagReasonDn == "ENTRY STRUCTURE"
            stEntryStruct := stEntryStruct + 1
        else if diagReasonDn == "ENTRY POSITION"
            stEntryPos := stEntryPos + 1
        else if diagReasonDn == "EMA EXPANSION"
            stEmaExp := stEmaExp + 1
        else if diagReasonDn == "CANDLE DIRECTION" or diagReasonDn == "CANDLE BODY"
            stCandle := stCandle + 1
        else if diagReasonDn == "ADX"
            stAdx := stAdx + 1
        else if diagReasonDn == "VOLATILITY"
            stVol := stVol + 1
        else if diagReasonDn == "CHASING"
            stChase := stChase + 1
        else if diagReasonDn == "OPTIONAL FILTERS"
            stOpt := stOpt + 1
        else if diagReasonDn == "RISK TOO LARGE" or diagReasonDn == "INVALID STRUCTURE" or diagReasonDn == "ATR INVALID"
            stRisk := stRisk + 1
        else if diagReasonDn == "SCORE"
            stScore := stScore + 1

    //--- Phase 4A aggregate accumulators (candidate-level context)
    stSumScore := stSumScore + sellScore
    stSumSlope := stSumSlope + h4SlopePct
    stSumSep   := stSumSep + devSep
    stSumDist  := stSumDist + h4EmaDistAtr
    stSumAtr   := stSumAtr + atrVsAvg
    stSumAge   := stSumAge + h1AgeBars

    //--- A newer signal finalizes an older still-unresolved one
    if sellSig and trActive
        trOutcome := "SUPERSEDED"
        trFinalR  := (trEntry - close) / math.max(trRisk, 1e-10)
        resH4     := h4Bull ? "BULLISH" : h4Bear ? "BEARISH" : "NEUTRAL"
        resH1     := h1FastV > h1SlowV ? "BULLISH" : h1FastV < h1SlowV ? "BEARISH" : "NEUTRAL"
        resAdx    := str.tostring(adxVal, "#.##")
        resBars   := trElapsed
        resTime   := time
        resAlign  := (trDir == "BUY" and h4Bull and h1ConfUp) or (trDir == "SELL" and h4Bear and h1ConfDn) ? "INTACT" : "BROKEN"
        stOutSup  := stOutSup + 1
        stResCnt  := stResCnt + 1
        stSumRes  := stSumRes + trElapsed
        array.push(outLog, str.tostring(trTime, "MM-dd HH:mm") + " " + trDir + " E" + str.tostring(trEntry, format.mintick) + " -> SUPERSEDED (" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m) H4 " + resH4 + " H1 " + resH1 + " ALIGN " + resAlign + " MFE +" + str.tostring(trMFE, "#.##") + "R MAE -" + str.tostring(trMAE, "#.##") + "R")
        if array.size(outLog) > 20
            array.remove(outLog, 0)
        //--- CVOUT alert: machine-readable resolution record (diagnostic only)
        if enableDiagAlerts
            alert("CVOUT|" + syminfo.ticker + "|" + timeframe.period + "|" + trDir + "|" + trOutcome + "|" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m|MFE=+" + str.tostring(trMFE, "#.##") + "R|MAE=-" + str.tostring(trMAE, "#.##") + "R|R=" + (na(trFinalR) ? "--" : str.tostring(trFinalR, "#.##")) + "|H4=" + resH4 + "|H1=" + resH1 + "|ALIGN=" + resAlign + "|E=" + str.tostring(trEntry, format.mintick) + "|SL=" + str.tostring(trSL, format.mintick) + "|TP1=" + str.tostring(trTP1, format.mintick) + "|TP2=" + str.tostring(trTP2, format.mintick) + "|T=" + str.tostring(trTime, "MM-dd HH:mm"), alert.freq_once_per_bar_close)
    if sellSig
        prevSigBar := bar_index
        trActive  := true
        trBar     := bar_index
        trTime    := time
        trDir     := "SELL"
        trEntry   := entry
        trSL      := slSell
        trTP1     := tp1Sell
        trTP2     := tp2Sell
        trRisk    := riskSell
        trElapsed := 0
        trMFE     := 0.0
        trMAE     := 0.0
        trFinalR  := na
        trSlHit   := false
        trTp1Hit  := false
        trTp2Hit  := false
        trOutcome := "unresolved"

    //--- Optional CVLOG alert (mirrored)
    if enableDiagAlerts
        alert("CVLOG|" + syminfo.ticker + "|" + timeframe.period + "|SELL|" + devResult + "|" + str.tostring(sellScore) + "|" + (devReason == "" ? "OK" : devReason) + "|ADX=" + str.tostring(adxVal, "#.##") + "|ATR=" + str.tostring(atrVal, "#.##") + "|RISK=" + str.tostring(riskAtrSell, "#.##") + "A|RR=" + str.tostring(rrTp1Sell, "#.##") + "/" + str.tostring(rrTp2Sell, "#.##") + "|E=" + str.tostring(entry, format.mintick) + "|SL=" + str.tostring(slSell, format.mintick) + "|TP1=" + str.tostring(tp1Sell, format.mintick) + "|TP2=" + str.tostring(tp2Sell, format.mintick) + "|T=" + str.tostring(time, "MM-dd HH:mm"), alert.freq_once_per_bar_close)

//--- Post-signal outcome tracking (confirmed bars AFTER the signal
//--- bar only; MFE/MAE in R; TP/SL hits; outcome classification).
//--- Observational - these values never feed back into the engine.
if decisionLogger and trActive and isConfirmed and bar_index > trBar
    trElapsed := trElapsed + 1
    favR = trDir == "BUY" ? (high - trEntry) / math.max(trRisk, 1e-10) : (trEntry - low) / math.max(trRisk, 1e-10)
    advR = trDir == "BUY" ? (trEntry - low) / math.max(trRisk, 1e-10) : (high - trEntry) / math.max(trRisk, 1e-10)
    trMFE := math.max(trMFE, favR)
    trMAE := math.max(trMAE, advR)
    slT  = trDir == "BUY" ? low <= trSL  : high >= trSL
    tp1T = trDir == "BUY" ? high >= trTP1 : low <= trTP1
    tp2T = trDir == "BUY" ? high >= trTP2 : low <= trTP2
    if slT
        trSlHit := true
    if tp1T
        trTp1Hit := true
    if tp2T
        trTp2Hit := true
    if trOutcome == "unresolved"
        //--- SL and TP touched inside the same candle: order unknowable
        if slT and (tp1T or tp2T)
            trOutcome := "AMBIGUOUS"
            trFinalR  := trDir == "BUY" ? (close - trEntry) / math.max(trRisk, 1e-10) : (trEntry - close) / math.max(trRisk, 1e-10)
            trActive  := false
        else if slT
            trOutcome := "SL FIRST"
            trFinalR  := -1.0
            trActive  := false
        else if tp2T
            trOutcome := "TP2 FIRST"
            trFinalR  := trDir == "BUY" ? (close - trEntry) / math.max(trRisk, 1e-10) : (trEntry - close) / math.max(trRisk, 1e-10)
            trActive  := false
        else if tp1T
            trOutcome := "TP1 FIRST"
            trFinalR  := trDir == "BUY" ? (close - trEntry) / math.max(trRisk, 1e-10) : (trEntry - close) / math.max(trRisk, 1e-10)
            trActive  := false
        else if trElapsed >= outcomeBars
            trOutcome := "EXPIRED"
            trFinalR  := trDir == "BUY" ? (close - trEntry) / math.max(trRisk, 1e-10) : (trEntry - close) / math.max(trRisk, 1e-10)
            trActive  := false
    if not trActive
        //--- Phase 4A resolution context (post-hoc; never feeds back)
        resH4    := h4Bull ? "BULLISH" : h4Bear ? "BEARISH" : "NEUTRAL"
        resH1    := h1FastV > h1SlowV ? "BULLISH" : h1FastV < h1SlowV ? "BEARISH" : "NEUTRAL"
        resAdx   := str.tostring(adxVal, "#.##")
        resBars  := trElapsed
        resTime  := time
        resAlign := (trDir == "BUY" and h4Bull and h1ConfUp) or (trDir == "SELL" and h4Bear and h1ConfDn) ? "INTACT" : "BROKEN"
        stResCnt := stResCnt + 1
        stSumRes := stSumRes + trElapsed
        if trOutcome == "SL FIRST"
            stOutSl := stOutSl + 1
        else if trOutcome == "TP1 FIRST"
            stOutTp1 := stOutTp1 + 1
        else if trOutcome == "TP2 FIRST"
            stOutTp2 := stOutTp2 + 1
        else if trOutcome == "AMBIGUOUS"
            stOutAmb := stOutAmb + 1
        else if trOutcome == "EXPIRED"
            stOutExp := stOutExp + 1
        array.push(outLog, str.tostring(trTime, "MM-dd HH:mm") + " " + trDir + " E" + str.tostring(trEntry, format.mintick) + " -> " + trOutcome + " (" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m) H4 " + resH4 + " H1 " + resH1 + " ALIGN " + resAlign + " MFE +" + str.tostring(trMFE, "#.##") + "R MAE -" + str.tostring(trMAE, "#.##") + "R R " + (na(trFinalR) ? "--" : str.tostring(trFinalR, "#.##")))
        if array.size(outLog) > 20
            array.remove(outLog, 0)
        //--- CVOUT alert: machine-readable resolution record (diagnostic only)
        if enableDiagAlerts
            alert("CVOUT|" + syminfo.ticker + "|" + timeframe.period + "|" + trDir + "|" + trOutcome + "|" + str.tostring(trElapsed) + "b " + str.tostring(trElapsed * tfSec / 60, "#") + "m|MFE=+" + str.tostring(trMFE, "#.##") + "R|MAE=-" + str.tostring(trMAE, "#.##") + "R|R=" + (na(trFinalR) ? "--" : str.tostring(trFinalR, "#.##")) + "|H4=" + resH4 + "|H1=" + resH1 + "|ALIGN=" + resAlign + "|E=" + str.tostring(trEntry, format.mintick) + "|SL=" + str.tostring(trSL, format.mintick) + "|TP1=" + str.tostring(trTP1, format.mintick) + "|TP2=" + str.tostring(trTP2, format.mintick) + "|T=" + str.tostring(trTime, "MM-dd HH:mm"), alert.freq_once_per_bar_close)

var table aud = na

if auditMode
    if na(aud)
        aud := table.new(position.top_right, 2, 32, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))

    //--- Header
    table.cell(aud, 0, 0, "— SIGNAL AUDIT —", text_color = color.white,  text_size = size.small)
    table.cell(aud, 1, 0, "",                  text_color = color.white,  text_size = size.small)
    //--- Timeframe policy (always shown, any chart)
    table.cell(aud, 0, 1, "SIGNAL TF", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 1, signalTfTxt, text_color = color.white,   text_size = size.normal)
    table.cell(aud, 0, 2, "SIGNAL MODE", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 2, audModeTxt, text_color = audModeCol,     text_size = size.normal)
    //--- Reason: blocked timeframe, or the first failed gate of a
    //--- rejected candidate setup (supported timeframes)
    table.cell(aud, 0, 3, "REASON", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 3, isSupportedSignalTF ? rejectTxt : tfReasonTxt, text_color = color.red, text_size = size.small)

//--- Detail rows (supported signal timeframes only). Separate top-level
//--- if: the target Pine build does not support the 'end' keyword, so
//--- blocks are delimited purely by indentation/dedent.
if auditMode and isSupportedSignalTF
    //--- Signal + score
    table.cell(aud, 0, 4, "SIGNAL", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 4, audDirTxt, text_color = audSigCol,   text_size = size.normal)
    table.cell(aud, 0, 5, "SCORE", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 5, audScoreTxt, text_color = color.silver, text_size = size.normal)
    //--- 4H trend
    table.cell(aud, 0, 6, "4H TREND", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 6, audTrendTxt, text_color = audHas ? (audTrendOk ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 7, "EMA50 / EMA200", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 7, (na(audEma50) ? "--" : str.tostring(audEma50, format.mintick)) + " / " + (na(audEma200) ? "--" : str.tostring(audEma200, format.mintick)), text_color = color.silver, text_size = size.small)
    //--- 4H slope
    table.cell(aud, 0, 8, "4H SLOPE", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 8, audSlopeTxt + (audHas ? "  (" + slopeDirTxt + ")" : ""), text_color = audHas ? (audSlopeOk ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 9, "EMA50 cur/prev", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 9, (na(audEma50) ? "--" : str.tostring(audEma50, format.mintick)) + " / " + (na(audEma50Prev) ? "--" : str.tostring(audEma50Prev, format.mintick)), text_color = color.silver, text_size = size.small)
    //--- 1H confirmation
    table.cell(aud, 0, 10, "1H CONF", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 10, audH1Txt, text_color = audHas ? (audH1Ok ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 11, "1H EMA fast/slow", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 11, (na(audH1Fast) ? "--" : str.tostring(audH1Fast, format.mintick)) + " / " + (na(audH1Slow) ? "--" : str.tostring(audH1Slow, format.mintick)), text_color = color.silver, text_size = size.small)
    //--- Entry trigger (on the chart TF)
    table.cell(aud, 0, 12, entryTfTxt, text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 12, audCrossTxt, text_color = audHas ? (audCrossOk ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 13, "EMA9 / EMA21", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 13, (na(audEmaF) ? "--" : str.tostring(audEmaF, format.mintick)) + " / " + (na(audEmaS) ? "--" : str.tostring(audEmaS, format.mintick)), text_color = color.silver, text_size = size.small)
    //--- ADX
    table.cell(aud, 0, 14, "ADX", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 14, audAdxTxt, text_color = audHas ? (audAdxOk ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 15, "ADX val / min", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 15, (na(audAdx) ? "--" : str.tostring(audAdx, "#.##")) + " / " + (na(audAdxMin) ? "--" : str.tostring(audAdxMin, "#.##")), text_color = color.silver, text_size = size.small)
    //--- Volatility / volume (rows show a contribution only when the weight is enabled)
    table.cell(aud, 0, 16, "VOLATILITY", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 16, atrVolWeight > 0 ? audVolTxt : "", text_color = audHas ? (audVolOk ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(aud, 0, 17, "VOLUME", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 17, volWeight > 0 ? audVolConfTxt : "", text_color = audHas ? (audVolConfOk ? color.green : color.red) : color.silver, text_size = size.small)
    //--- Total (exact existing score)
    table.cell(aud, 0, 18, "TOTAL", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 18, audScoreTxt, text_color = color.white, text_size = size.normal)
    //--- Price levels (structural SL + risk-based TPs)
    table.cell(aud, 0, 19, "ENTRY", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 19, na(lastEntry) ? "--" : str.tostring(lastEntry, format.mintick), text_color = color.white, text_size = size.normal)
    table.cell(aud, 0, 20, "STRUCT SL", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 20, na(audStructSL) ? "--" : str.tostring(audStructSL, format.mintick), text_color = color.silver, text_size = size.small)
    table.cell(aud, 0, 21, "FINAL SL", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 21, na(lastSL) ? "--" : str.tostring(lastSL, format.mintick), text_color = color.red, text_size = size.normal)
    table.cell(aud, 0, 22, "SL MODE", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 22, na(lastSL) ? "--" : audSlMode, text_color = color.silver, text_size = size.small)
    table.cell(aud, 0, 23, "RISK", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 23, na(lastRisk) ? "--" : str.tostring(lastRisk, format.mintick), text_color = color.white, text_size = size.normal)
    table.cell(aud, 0, 24, "RISK ATR", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 24, na(lastRiskAtr) ? "--" : str.tostring(lastRiskAtr, "#.##") + " ATR", text_color = color.white, text_size = size.normal)
    table.cell(aud, 0, 25, "TP1", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 25, na(lastTP1) ? "--" : str.tostring(lastTP1, format.mintick), text_color = tpCol, text_size = size.normal)
    table.cell(aud, 0, 26, "TP1 R", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 26, na(lastRR1) ? "--" : str.tostring(lastRR1, "#.##"), text_color = color.silver, text_size = size.small)
    table.cell(aud, 0, 27, "TP2", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 27, na(lastTP2) ? "--" : str.tostring(lastTP2, format.mintick), text_color = tpCol, text_size = size.normal)
    table.cell(aud, 0, 28, "TP2 R", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 28, na(lastRR2) ? "--" : str.tostring(lastRR2, "#.##"), text_color = color.silver, text_size = size.small)
    table.cell(aud, 0, 29, "R:R", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 29, na(lastRR1) ? "--" : str.tostring(lastRR1, "#.##") + " / " + str.tostring(lastRR2, "#.##"), text_color = color.white, text_size = size.normal)
    //--- Signal bar
    table.cell(aud, 0, 30, "BAR", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 30, syminfo.ticker + " " + timeframe.period + "  " + (na(audBarTime) ? "--" : str.tostring(audBarTime, "yyyy-MM-dd HH:mm")), text_color = color.silver, text_size = size.small)
    table.cell(aud, 0, 31, "CONFIRMED", text_color = color.silver, text_size = size.small)
    table.cell(aud, 1, 31, audConfirmedTxt, text_color = color.green, text_size = size.small)

//--- Cleanup when the mode is off
if not auditMode
    if not na(aud)
        table.delete(aud)
        aud := na

//==============================================================
// Diagnostic tables (Signal Diagnostic Mode only)
//  Summary table: recent events, one compact line each.
//  Detail table : the latest event's exact snapshot + outcome
//  tracking state. Rebuilt only when needed (summary) or per
//  bar (detail, fixed small grid) - no chart clutter in normal
//  mode, nothing rendered when the mode is off.
//==============================================================
var table diagTbl    = na
var table diagDetTbl = na
var table gateTbl    = na
var table statsTbl   = na
var int   diagRows   = 0
var int   evRendered = -1

if decisionLogger
    if na(diagTbl) or diagRows != diagHistorySize
        if not na(diagTbl)
            table.delete(diagTbl)
        diagTbl := table.new(position.top_right, 1, diagHistorySize + 1, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))
        diagRows := diagHistorySize
        evRendered := -1
    if evRendered != array.size(evTime)
        evRendered := array.size(evTime)
        table.cell(diagTbl, 0, 0, "RECENT DECISIONS (" + str.tostring(array.size(evTime)) + ")", text_color = color.white, text_size = size.small)
        for i = 0 to diagHistorySize - 1
            if i < array.size(evTime)
                rowTxt = str.tostring(array.get(evTime, i), "MM-dd HH:mm") + " " + array.get(evTf, i) + " " + array.get(evDir, i) + " " + array.get(evResult, i) + (array.get(evResult, i) == "SIGNAL" ? " " + str.tostring(array.get(evScore, i)) + " · E " + str.tostring(array.get(evEntry, i), format.mintick) + " · R " + str.tostring(array.get(evRiskA, i), "#.##") + "A · RR " + str.tostring(array.get(evRR1, i), "#.##") + "/" + str.tostring(array.get(evRR2, i), "#.##") : " · " + array.get(evReason, i))
                table.cell(diagTbl, 0, i + 1, rowTxt, text_color = color.silver, text_size = size.small)
            else
                table.cell(diagTbl, 0, i + 1, "", text_color = color.silver, text_size = size.small)

    if na(diagDetTbl)
        diagDetTbl := table.new(position.top_right, 2, 29, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))

    //--- Latest-event detail (built from the frozen snapshots)
    hasEv = not na(devTime)
    evHeadTxt  = hasEv ? str.tostring(devTime, "MM-dd HH:mm") + " " + devTf + " " + devDir + " · " + devResult + (devResult == "SIGNAL" ? " " + devSigType : "") : "NO EVENTS YET"
    h4Txt      = hasEv ? (devRegimeOk ? "PASS" : "FAIL") + " · " + devSlope + " · SEP " + str.tostring(devSep, "#.##") + "%" : "—"
    e50Txt     = hasEv ? str.tostring(devE50, format.mintick) + " / " + str.tostring(devE200, format.mintick) + " (prev " + str.tostring(devE50Prev, format.mintick) + ")" : "—"
    h1Txt      = hasEv ? devH1 + " · 21/50 " + str.tostring(devH1Fast, format.mintick) + "/" + str.tostring(devH1Slow, format.mintick) + " · CLOSE " + str.tostring(devH1Close, format.mintick) : "—"
    entryTxt   = hasEv ? devEntry : "—"
    candleTxt  = hasEv ? devCandle : "—"
    emaTxt     = hasEv ? str.tostring(devEmaF, format.mintick) + " / " + str.tostring(devEmaS, format.mintick) + " (gap " + str.tostring(devGapPrev, "#.##") + "→" + str.tostring(devGap, "#.##") + ")" : "—"
    qualTxt    = hasEv ? devQual + " (min " + str.tostring(devAdxMin, "#.##") + ")" : "—"
    scoreTxt   = hasEv ? str.tostring(devScore) + "/" + str.tostring(devMax) + " · " + devScoreBrk + " · min " + str.tostring(devMin) : "—"
    posTxt     = hasEv ? "E " + str.tostring(devEntryPx, format.mintick) + " · SL " + str.tostring(devSL, format.mintick) + " · TP1 " + str.tostring(devTP1, format.mintick) + " · TP2 " + str.tostring(devTP2, format.mintick) : "—"
    rrTxt      = hasEv ? str.tostring(devRisk, format.mintick) + " · " + str.tostring(devRiskAtr, "#.##") + "A · RR " + str.tostring(devRR1, "#.##") + "/" + str.tostring(devRR2, "#.##") : "—"
    trackTxt   = trActive ? str.tostring(trElapsed) + "/" + str.tostring(outcomeBars) + " bars · MFE +" + str.tostring(trMFE, "#.##") + "R · MAE -" + str.tostring(trMAE, "#.##") + "R" : na(trFinalR) ? "—" : str.tostring(trElapsed) + " bars · MFE +" + str.tostring(trMFE, "#.##") + "R · MAE -" + str.tostring(trMAE, "#.##") + "R"
    hitsTxt    = (trActive or not na(trFinalR)) ? (trTp1Hit ? "TP1 HIT" : "TP1 NOT HIT") + " · " + (trTp2Hit ? "TP2 HIT" : "TP2 NOT HIT") + " · " + (trSlHit ? "SL HIT" : "SL NOT HIT") : "—"
    lastOutTxt = array.size(outLog) > 0 ? array.get(outLog, array.size(outLog) - 1) : "—"
    //--- Phase 4A context display (frozen event snapshot + resolution)
    devSlopeTxt  = hasEv ? (devH4SlopePct > 0 ? "+" : "") + str.tostring(devH4SlopePct, "#.###") + "%" : "—"
    devSepTxt    = hasEv ? str.tostring(devSep, "#.###") + "%" : "—"
    devDistTxt   = hasEv ? str.tostring(devH4DistAtr, "#.##") + " ATR" : "—"
    devAtrTxt    = hasEv ? devAtrRegime + " " + str.tostring(devAtrVsAvg, "#") + "%" : "—"
    devAgeTxt    = hasEv ? str.tostring(devH1Age) + "b " + str.tostring(devH1AgeMin, "#") + "m" : "—"
    devSinceTxt  = hasEv ? (na(devSinceSig) ? "N/A" : str.tostring(devSinceSig) + "b " + str.tostring(devSinceSig * tfSec / 60, "#") + "m") : "—"
    resTxt       = resBars > 0 ? str.tostring(resBars) + "b " + str.tostring(resBars * tfSec / 60, "#") + "m" : "—"
    resH4Txt     = resH4 == "" ? "—" : resH4
    resH1Txt     = resH1 == "" ? "—" : resH1
    resAlignTxt  = resAlign == "" ? "—" : resAlign
    resAlignCol  = resAlign == "INTACT" ? color.green : resAlign == "BROKEN" ? color.red : color.silver

    table.cell(diagDetTbl, 0, 0, "— DECISION LOG —", text_color = color.white, text_size = size.small)
    table.cell(diagDetTbl, 1, 0, "", text_color = color.white, text_size = size.small)
    table.cell(diagDetTbl, 0, 1, "EVENT", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 1, evHeadTxt, text_color = devResult == "SIGNAL" ? color.green : color.white, text_size = size.small)
    table.cell(diagDetTbl, 0, 2, "DECISION", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 2, hasEv ? devDecision : "—", text_color = hasEv ? (devDecision == "REJECTED" ? color.red : color.green) : color.silver, text_size = size.normal)
    table.cell(diagDetTbl, 0, 3, "REASON", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 3, hasEv ? (devReason == "" ? "—" : devReason) : "—", text_color = color.red, text_size = size.small)
    table.cell(diagDetTbl, 0, 4, "4H", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 4, h4Txt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 5, "EMA50/200", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 5, e50Txt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 6, "1H", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 6, h1Txt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 7, "ENTRY", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 7, entryTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 8, "CANDLE", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 8, candleTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 9, "EMA9/21", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 9, emaTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 10, "QUALITY", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 10, qualTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 11, "SCORE", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 11, scoreTxt, text_color = color.white, text_size = size.small)
    table.cell(diagDetTbl, 0, 12, "POSITION", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 12, posTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 13, "RISK/RR", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 13, rrTxt, text_color = color.white, text_size = size.small)
    table.cell(diagDetTbl, 0, 14, "TRACK", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 14, trackTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 15, "HITS", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 15, hitsTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 16, "OUTCOME", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 16, trActive ? "TRACKING…" : lastOutTxt, text_color = color.silver, text_size = size.small)
    //--- Phase 4A market context (observation only)
    table.cell(diagDetTbl, 0, 17, "— CONTEXT —", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 17, "", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 18, "H4 SLOPE", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 18, devSlopeTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 19, "H4 SEP", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 19, devSepTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 20, "H4 EMA DIST", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 20, devDistTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 21, "ATR REGIME", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 21, devAtrTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 22, "1H AGE", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 22, devAgeTxt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 23, "SINCE SIG", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 23, devSinceTxt, text_color = color.silver, text_size = size.small)
    //--- Phase 4A resolution context (post-hoc)
    table.cell(diagDetTbl, 0, 24, "— RESOLUTION —", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 24, "", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 25, "RESOLUTION", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 25, resTxt, text_color = color.white, text_size = size.small)
    table.cell(diagDetTbl, 0, 26, "H4 EXIT", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 26, resH4Txt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 27, "1H EXIT", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 27, resH1Txt, text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 0, 28, "ALIGNMENT", text_color = color.silver, text_size = size.small)
    table.cell(diagDetTbl, 1, 28, resAlignTxt, text_color = resAlignCol, text_size = size.small)

    //--- Gate status table (latest candidate's first-failure chain)
    if na(gateTbl)
        gateTbl := table.new(position.top_right, 2, 17, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))
    gsRegime   = hasEv ? (devRegimeOk         ? "PASS" : "FAIL") : "N/A"
    gsSlope    = hasEv ? (devGateSlope        ? "PASS" : "FAIL") : "N/A"
    gsSep      = hasEv ? (devGateSep          ? "PASS" : "FAIL") : "N/A"
    gsH1Struct = hasEv ? (devGateH1Struct     ? "PASS" : "FAIL") : "N/A"
    gsH1Mom    = hasEv ? (devGateH1Mom        ? "PASS" : "FAIL") : "N/A"
    gsEntrySt  = hasEv ? (devGateEntryStruct  ? "PASS" : "FAIL") : "N/A"
    gsEntryPos = hasEv ? (devGateEntryPos     ? "PASS" : "FAIL") : "N/A"
    gsEmaExp   = hasEv ? (devGateEmaExp       ? "PASS" : "FAIL") : "N/A"
    gsTrigger  = hasEv ? (devGateTrigger      ? "PASS" : "FAIL") : "N/A"
    gsCandle   = hasEv ? (devGateCandle       ? "PASS" : "FAIL") : "N/A"
    gsAdx      = hasEv ? (devGateAdx          ? "PASS" : "FAIL") : "N/A"
    gsVol      = hasEv ? (devGateVol          ? "PASS" : "FAIL") : "N/A"
    gsChase    = hasEv ? (devGateChase        ? "PASS" : "FAIL") : "N/A"
    gsRisk     = hasEv ? (devGateRisk         ? "PASS" : "FAIL") : "N/A"
    gsScore    = hasEv ? str.tostring(devScore) + "/" + str.tostring(devMax) : "N/A"

    table.cell(gateTbl, 0, 0, "— GATE STATUS —", text_color = color.white, text_size = size.small)
    table.cell(gateTbl, 1, 0, "", text_color = color.white, text_size = size.small)
    table.cell(gateTbl, 0, 1, "4H REGIME", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 1, gsRegime, text_color = gsRegime == "PASS" ? color.green : gsRegime == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 2, "4H SLOPE", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 2, gsSlope, text_color = gsSlope == "PASS" ? color.green : gsSlope == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 3, "4H SEPARATION", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 3, gsSep, text_color = gsSep == "PASS" ? color.green : gsSep == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 4, "1H STRUCTURE", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 4, gsH1Struct, text_color = gsH1Struct == "PASS" ? color.green : gsH1Struct == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 5, "1H MOMENTUM", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 5, gsH1Mom, text_color = gsH1Mom == "PASS" ? color.green : gsH1Mom == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 6, "ENTRY STRUCTURE", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 6, gsEntrySt, text_color = gsEntrySt == "PASS" ? color.green : gsEntrySt == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 7, "ENTRY POSITION", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 7, gsEntryPos, text_color = gsEntryPos == "PASS" ? color.green : gsEntryPos == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 8, "EMA EXPANSION", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 8, gsEmaExp, text_color = gsEmaExp == "PASS" ? color.green : gsEmaExp == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 9, "TRIGGER", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 9, gsTrigger, text_color = gsTrigger == "PASS" ? color.green : gsTrigger == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 10, "CANDLE", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 10, gsCandle, text_color = gsCandle == "PASS" ? color.green : gsCandle == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 11, "ADX", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 11, gsAdx, text_color = gsAdx == "PASS" ? color.green : gsAdx == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 12, "VOLATILITY", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 12, gsVol, text_color = gsVol == "PASS" ? color.green : gsVol == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 13, "CHASING", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 13, gsChase, text_color = gsChase == "PASS" ? color.green : gsChase == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 14, "RISK", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 14, gsRisk, text_color = gsRisk == "PASS" ? color.green : gsRisk == "FAIL" ? color.red : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 15, "SCORE", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 15, gsScore, text_color = hasEv ? (devGateScore ? color.green : color.red) : color.silver, text_size = size.small)
    table.cell(gateTbl, 0, 16, "DECISION", text_color = color.silver, text_size = size.small)
    table.cell(gateTbl, 1, 16, hasEv ? devDecision : "N/A", text_color = hasEv ? (devDecision == "REJECTED" ? color.red : color.green) : color.silver, text_size = size.small)

    //--- Decision statistics (which filter kills the most setups) +
    //--- Phase 4A candidate-level averages (observation only)
    avgScore = stCand > 0 ? stSumScore / stCand : na
    avgSlope = stCand > 0 ? stSumSlope / stCand : na
    avgSep   = stCand > 0 ? stSumSep / stCand : na
    avgDist  = stCand > 0 ? stSumDist / stCand : na
    avgAtr   = stCand > 0 ? stSumAtr / stCand : na
    avgAge   = stCand > 0 ? stSumAge / stCand : na
    avgRes   = stResCnt > 0 ? stSumRes / stResCnt : na
    if na(statsTbl)
        statsTbl := table.new(position.top_right, 2, 27, border_width = 1, border_color = color.new(color.gray, 0), bgcolor = color.new(color.rgb(26, 26, 32), 0))
    table.cell(statsTbl, 0, 0, "— DIAGNOSTIC STATS —", text_color = color.white, text_size = size.small)
    table.cell(statsTbl, 1, 0, "", text_color = color.white, text_size = size.small)
    table.cell(statsTbl, 0, 1, "CANDIDATES", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 1, str.tostring(stCand), text_color = color.white, text_size = size.small)
    table.cell(statsTbl, 0, 2, "SIGNALS", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 2, str.tostring(stSig), text_color = color.green, text_size = size.small)
    table.cell(statsTbl, 0, 3, "REJECTED", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 3, str.tostring(stRej), text_color = color.red, text_size = size.small)
    table.cell(statsTbl, 0, 4, "4H REGIME", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 4, st4hRegime > 0 ? str.tostring(st4hRegime) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 5, "4H SLOPE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 5, st4hSlope > 0 ? str.tostring(st4hSlope) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 6, "4H SEPARATION", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 6, st4hSep > 0 ? str.tostring(st4hSep) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 7, "1H STRUCTURE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 7, st1hStruct > 0 ? str.tostring(st1hStruct) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 8, "1H MOMENTUM", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 8, st1hMom > 0 ? str.tostring(st1hMom) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 9, "ENTRY STRUCTURE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 9, stEntryStruct > 0 ? str.tostring(stEntryStruct) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 10, "ENTRY POSITION", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 10, stEntryPos > 0 ? str.tostring(stEntryPos) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 11, "EMA EXPANSION", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 11, stEmaExp > 0 ? str.tostring(stEmaExp) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 12, "CANDLE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 12, stCandle > 0 ? str.tostring(stCandle) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 13, "ADX", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 13, stAdx > 0 ? str.tostring(stAdx) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 14, "VOLATILITY", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 14, stVol > 0 ? str.tostring(stVol) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 15, "CHASING", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 15, stChase > 0 ? str.tostring(stChase) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 16, "RISK", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 16, stRisk > 0 ? str.tostring(stRisk) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 17, "SCORE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 17, stScore > 0 ? str.tostring(stScore) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 18, "OPTIONAL FILTERS", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 18, stOpt > 0 ? str.tostring(stOpt) : "—", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 19, "AVG SCORE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 19, na(avgScore) ? "—" : str.tostring(avgScore, "#.#"), text_color = color.white, text_size = size.small)
    table.cell(statsTbl, 0, 20, "AVG H4 SLOPE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 20, na(avgSlope) ? "—" : (avgSlope > 0 ? "+" : "") + str.tostring(avgSlope, "#.###") + "%", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 21, "AVG H4 SEP", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 21, na(avgSep) ? "—" : str.tostring(avgSep, "#.###") + "%", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 22, "AVG H4 DIST", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 22, na(avgDist) ? "—" : str.tostring(avgDist, "#.##") + " ATR", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 23, "AVG ATR", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 23, na(avgAtr) ? "—" : str.tostring(avgAtr, "#") + "% of avg", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 24, "AVG 1H AGE", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 24, na(avgAge) ? "—" : str.tostring(avgAge, "#.#") + "b", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 25, "AVG RES", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 25, na(avgRes) ? "—" : str.tostring(avgRes, "#.#") + "b", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 0, 26, "OUTCOMES", text_color = color.silver, text_size = size.small)
    table.cell(statsTbl, 1, 26, "SL " + str.tostring(stOutSl) + " · TP1 " + str.tostring(stOutTp1) + " · TP2 " + str.tostring(stOutTp2) + " · AMB " + str.tostring(stOutAmb) + " · EXP " + str.tostring(stOutExp) + " · SUP " + str.tostring(stOutSup), text_color = color.silver, text_size = size.small)
else
    if not na(diagTbl)
        table.delete(diagTbl)
        diagTbl := na
    if not na(diagDetTbl)
        table.delete(diagDetTbl)
        diagDetTbl := na
    if not na(gateTbl)
        table.delete(gateTbl)
        gateTbl := na
    if not na(statsTbl)
        table.delete(statsTbl)
        statsTbl := na
