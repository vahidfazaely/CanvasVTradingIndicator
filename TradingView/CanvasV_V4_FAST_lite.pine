//@version=5
//+------------------------------------------------------------------+
//|  CanvasV V4 FAST Strategy — Lite (fast-compile build)           |
//|  Same signal logic as full version, lighter diagnostics.        |
//|  v5.0.0-lite                                                     |
//+------------------------------------------------------------------+
strategy("CanvasV V4 FAST Lite", shorttitle = "CanvasV V4 LITE", overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, max_lines_count = 10, max_labels_count = 20, calc_on_every_tick = false, process_orders_on_close = false)

VERSION = "v5.0.0-lite"

//--------------------------------------------------------------
// Inputs
//--------------------------------------------------------------
grpRegime  = "=== Regime ==="
grpDir     = "=== Direction / Momentum ==="
grpTgr     = "=== Triggers ==="
grpRisk    = "=== Risk ==="
grpExec    = "=== Execution ==="
grpVis     = "=== Visuals ==="
grpAlerts  = "=== Alerts ==="

//--- Regime
regimeBars     = input.int(10,  "Regime slope lookback (bars)", minval = 2, group = grpRegime)
regimeMinSlope = input.float(0.05, "Min regime slope (ATR per bar)", minval = 0, group = grpRegime)
atrRegimeLen   = input.int(100, "ATR regime lookback (bars)", minval = 20, group = grpRegime)
highVolPct     = input.float(130.0, "High volatility threshold (ATR % of its avg)", minval = 100, group = grpRegime)
atrPeriod      = input.int(14,  "ATR period", minval = 1, group = grpRegime)

//--- Direction / momentum
emaTrigLen  = input.int(9,  "Trigger EMA",  minval = 2, group = grpDir)
emaDirLen   = input.int(21, "Direction EMA", minval = 2, group = grpDir)
emaSlowLen  = input.int(50, "Slow EMA",     minval = 3, group = grpDir)
momSlopeBars = input.int(3, "Momentum slope bars", minval = 1, group = grpDir)

//--- Triggers
enablePullback    = input.bool(true, "Enable pullback-resume trigger", group = grpTgr)
enableBreakout    = input.bool(true, "Enable breakout trigger", group = grpTgr)
pullbackLookback  = input.int(5,    "Pullback lookback (bars)", minval = 2, group = grpTgr)
pullbackTolPct    = input.float(0.5, "Pullback touch tolerance (%)", minval = 0, group = grpTgr)
breakoutBars      = input.int(10,   "Breakout lookback (bars)", minval = 3, group = grpTgr)
maxExtAtr         = input.float(2.5, "Max entry extension (ATR from direction EMA)", minval = 0.1, group = grpTgr)
minBodyPct        = input.float(0.0, "Min candle body (%) (0 = off)", minval = 0, maxval = 100, group = grpTgr)

//--- Risk
swingLookback   = input.int(10,  "Swing lookback (bars)", minval = 2, group = grpRisk)
structBufferAtr = input.float(0.5, "Structure buffer (ATR)", minval = 0, group = grpRisk)
minRiskAtr      = input.float(0.5, "Minimum risk (ATR)", minval = 0.01, group = grpRisk)
maxRiskAtr      = input.float(2.5, "Maximum risk (ATR)", minval = 0.01, group = grpRisk)
tp1R            = input.float(1.0, "TP1 R multiple", minval = 0.01, group = grpRisk)
tp2R            = input.float(2.5, "TP2 R multiple", minval = 0.01, group = grpRisk)
atrFallbackMult = 1.5

//--- Execution (Phase 3)
enablePartialTP = input.bool(false, "Enable Partial Take-Profit (50/50 split)", group = grpExec)
enableMoveBE    = input.bool(false, "Enable Break-Even Adjustment", group = grpExec)
outcomeBars     = input.int(20, "Position expiry (bars)", minval = 2, group = grpExec)

//--- Session filter (Phase 3)
useSessionFilter = input.bool(false, "Enable Session Filter", group = grpExec)
sessionInput     = input.session("0800-1700:23456", "Trading Session", group = grpExec)

//--- Visuals
showPanel   = input.bool(true, "Show dashboard panel", group = grpVis)
showMarkers = input.bool(true, "Show BUY/SELL markers", group = grpVis)
showLevels  = input.bool(true, "Show Entry/SL/TP lines", group = grpVis)
showEMAs    = input.bool(false, "Show EMAs", group = grpVis)

//--- Alerts
enableAlerts = input.bool(false, "Enable entry alerts", group = grpAlerts)

//--------------------------------------------------------------
// Series
//--------------------------------------------------------------
emaTrig = ta.ema(close, emaTrigLen)
emaDir  = ta.ema(close, emaDirLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrPeriod)
atrAvg  = ta.sma(atrVal, atrRegimeLen)
atrVsAvg = atrVal / math.max(atrAvg, 1e-10) * 100

isConfirmed = barstate.isconfirmed

//--------------------------------------------------------------
// Regime
//--------------------------------------------------------------
regimeSlope = (emaSlow - emaSlow[regimeBars]) / math.max(atrVal * regimeBars, 1e-10)
trending    = math.abs(regimeSlope) >= regimeMinSlope
highVol     = atrVsAvg >= highVolPct
trendUp = trending and emaDir > emaSlow and emaSlow > emaSlow[regimeBars]
trendDn = trending and emaDir < emaSlow and emaSlow < emaSlow[regimeBars]

//--------------------------------------------------------------
// Direction + momentum
//--------------------------------------------------------------
momUp = emaTrig > emaTrig[momSlopeBars] and close >= emaDir
momDn = emaTrig < emaTrig[momSlopeBars] and close <= emaDir

setupUp = trendUp and momUp
setupDn = trendDn and momDn

//--------------------------------------------------------------
// Triggers
//--------------------------------------------------------------
pullbackTol = pullbackTolPct / 100.0
touchLowUp  = ta.lowest(low, pullbackLookback)[1] <= emaDir * (1 + pullbackTol)
touchHighDn = ta.highest(high, pullbackLookback)[1] >= emaDir * (1 - pullbackTol)
reclaimUp   = close > emaTrig and close[1] <= emaTrig[1]
reclaimDn   = close < emaTrig and close[1] >= emaTrig[1]
pullbackUp  = enablePullback and touchLowUp and reclaimUp
pullbackDn  = enablePullback and touchHighDn and reclaimDn

breakUp = enableBreakout and close > ta.highest(high, breakoutBars)[1]
breakDn = enableBreakout and close < ta.lowest(low, breakoutBars)[1]

triggerUp = pullbackUp or breakUp
triggerDn = pullbackDn or breakDn

//--------------------------------------------------------------
// Entry quality
//--------------------------------------------------------------
candleRange = high - low
bodyPct = candleRange > 0 ? math.abs(close - open) / candleRange * 100 : 0.0
bodyOkUp = minBodyPct <= 0 or (close > open and bodyPct >= minBodyPct)
bodyOkDn = minBodyPct <= 0 or (close < open and bodyPct >= minBodyPct)

extAtrUp = (close - emaDir) / math.max(atrVal, 1e-10)
extAtrDn = (emaDir - close) / math.max(atrVal, 1e-10)
extOkUp  = extAtrUp <= maxExtAtr
extOkDn  = extAtrDn <= maxExtAtr

//--------------------------------------------------------------
// Risk validation
//--------------------------------------------------------------
entry = close
atrUsable = not na(atrVal) and atrVal > 0
swingLow  = ta.lowest(low, swingLookback)[1]
swingHigh = ta.highest(high, swingLookback)[1]
structSLBuy  = swingLow  - atrVal * structBufferAtr
structSLSell = swingHigh + atrVal * structBufferAtr

riskStructBuy = entry - structSLBuy
slModeBuy     = riskStructBuy >= minRiskAtr * atrVal
slBuy         = slModeBuy ? structSLBuy : entry - atrFallbackMult * atrVal
riskBuy       = entry - slBuy
riskAtrBuy    = riskBuy / math.max(atrVal, 1e-10)
riskGateBuyOk = atrUsable and slBuy < entry and riskAtrBuy <= maxRiskAtr
tp1Buy        = entry + riskBuy * tp1R
tp2Buy        = entry + riskBuy * tp2R

riskStructSell = structSLSell - entry
slModeSell     = riskStructSell >= minRiskAtr * atrVal
slSell         = slModeSell ? structSLSell : entry + atrFallbackMult * atrVal
riskSell       = slSell - entry
riskAtrSell    = riskSell / math.max(atrVal, 1e-10)
riskGateSellOk = atrUsable and slSell > entry and riskAtrSell <= maxRiskAtr
tp1Sell        = entry - riskSell * tp1R
tp2Sell        = entry - riskSell * tp2R

//--------------------------------------------------------------
// Config sanity
//--------------------------------------------------------------
cfgOk = emaTrigLen < emaDirLen and emaDirLen < emaSlowLen and swingLookback >= 2 and tp1R > 0 and tp2R > tp1R and maxRiskAtr > minRiskAtr

//--------------------------------------------------------------
// Session filter
//--------------------------------------------------------------
inSession = not useSessionFilter or not na(time(timeframe.period, sessionInput))

//--------------------------------------------------------------
// Strategy state variables
//--------------------------------------------------------------
var float  stratSL     = na
var float  stratTP1    = na
var float  stratTP2    = na
var float  stratRisk   = na
var float  stratRiskAtr = na
var int    stratDir    = 0
var string stratDirTxt = ""
var string stratTrigTxt = ""
var int    stratEntryBar = na
var int    stratAge     = 0
var float  stratMFE     = 0.0
var float  stratMAE     = 0.0
var bool   stratTp1Filled = false

//--- Last signal for the panel
var int    lastSigBar  = na
var string lastSigTxt  = "WAIT"
var string lastTrigTxt = "—"
var float  lastEntry   = na
var float  lastSL      = na
var float  lastTP1     = na
var float  lastTP2     = na
var float  lastRiskAtr = na
var float  lastRR1     = na
var float  lastRR2     = na
var string lastOutcome = ""
var float  lastFinalR  = na

//--- Levels
var line  lnEntry = na
var line  lnSL    = na
var line  lnTP1   = na
var line  lnTP2   = na
var label lblEntry = na
var label lblSL    = na
var label lblTP1   = na
var label lblTP2   = na

//--- Counters
var int    stBuy   = 0
var int    stSell  = 0
var int    stOutSl  = 0
var int    stOutTp1 = 0
var int    stOutTp2 = 0
var int    stOutExp = 0
var int    stWin    = 0
var int    stLoss   = 0

//--------------------------------------------------------------
// Helpers
//--------------------------------------------------------------
f_rtxt(v)  => na(v) ? "—" : str.tostring(v, format.mintick)

//--------------------------------------------------------------
// Candidates + entries
//--------------------------------------------------------------
candUp = isConfirmed and cfgOk and setupUp and triggerUp
candDn = isConfirmed and cfgOk and setupDn and triggerDn

candReasonUp = not extOkUp ? "ENTRY TOO EXTENDED" : not bodyOkUp ? "CANDLE BODY" : not atrUsable ? "ATR INVALID" : not riskGateBuyOk ? (riskAtrBuy > maxRiskAtr ? "RISK TOO WIDE" : "INVALID STRUCTURE") : not inSession ? "OUTSIDE SESSION" : ""
candReasonDn = not extOkDn ? "ENTRY TOO EXTENDED" : not bodyOkDn ? "CANDLE BODY" : not atrUsable ? "ATR INVALID" : not riskGateSellOk ? (riskAtrSell > maxRiskAtr ? "RISK TOO WIDE" : "INVALID STRUCTURE") : not inSession ? "OUTSIDE SESSION" : ""

entryUp = candUp and extOkUp and bodyOkUp and riskGateBuyOk and inSession
entryDn = candDn and extOkDn and bodyOkDn and riskGateSellOk and inSession

trigUpTxt = pullbackUp ? "PULLBACK" : "BREAKOUT"
trigDnTxt = pullbackDn ? "PULLBACK" : "BREAKOUT"

//--------------------------------------------------------------
// One-shot guard
//--------------------------------------------------------------
bool goLong  = entryUp and (na(stratEntryBar) or bar_index != stratEntryBar or stratDir != 1)
bool goShort = entryDn and (na(stratEntryBar) or bar_index != stratEntryBar or stratDir != -1)

//--------------------------------------------------------------
// Strategy entry — LONG
//--------------------------------------------------------------
if goLong
    strategy.entry("Long", strategy.long)
    if stratDir == -1
        stOutExp := stOutExp + 1
    stratDir     := 1
    stratDirTxt  := "BUY"
    stratTrigTxt := trigUpTxt
    stratEntryBar := bar_index
    stratSL      := slBuy
    stratTP1     := tp1Buy
    stratTP2     := tp2Buy
    stratRisk    := riskBuy
    stratRiskAtr := riskAtrBuy
    stratAge     := 0
    stratMFE     := 0.0
    stratMAE     := 0.0
    stratTp1Filled := false
    lastSigBar   := bar_index
    lastSigTxt   := "BUY"
    lastTrigTxt  := trigUpTxt
    lastEntry    := entry
    lastSL       := slBuy
    lastTP1      := tp1Buy
    lastTP2      := tp2Buy
    lastRiskAtr  := riskAtrBuy
    lastRR1      := (tp1Buy - entry) / math.max(riskBuy, 1e-10)
    lastRR2      := (tp2Buy - entry) / math.max(riskBuy, 1e-10)
    lastOutcome  := ""
    lastFinalR   := na
    stBuy := stBuy + 1
    //--- Levels
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lblEntry)
        label.delete(lblEntry)
    if not na(lblSL)
        label.delete(lblSL)
    if not na(lblTP1)
        label.delete(lblTP1)
    if not na(lblTP2)
        label.delete(lblTP2)
    if showLevels
        lnEntry := line.new(bar_index, entry,  bar_index, entry,  xloc = xloc.bar_index, extend = extend.right, color = color.new(color.white, 0), style = line.style_dotted, width = 2)
        lnSL    := line.new(bar_index, slBuy,  bar_index, slBuy,  xloc = xloc.bar_index, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 2)
        lnTP1   := line.new(bar_index, tp1Buy, bar_index, tp1Buy, xloc = xloc.bar_index, extend = extend.right, color = color.new(color.green, 0), style = line.style_dotted, width = 1)
        lnTP2   := line.new(bar_index, tp2Buy, bar_index, tp2Buy, xloc = xloc.bar_index, extend = extend.right, color = color.new(color.green, 0), style = line.style_dotted, width = 1)
        lblEntry := label.new(bar_index, entry,  "E " + f_rtxt(entry), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.white, size = size.tiny)
        lblSL    := label.new(bar_index, slBuy,  "SL " + f_rtxt(slBuy), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,   size = size.tiny)
        lblTP1   := label.new(bar_index, tp1Buy, "T1 " + f_rtxt(tp1Buy), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.tiny)
        lblTP2   := label.new(bar_index, tp2Buy, "T2 " + f_rtxt(tp2Buy), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.tiny)
    if enableAlerts
        alert(syminfo.ticker + " " + timeframe.period + ": BUY | " + trigUpTxt + " | E " + str.tostring(entry, format.mintick) + " SL " + str.tostring(slBuy, format.mintick) + " TP1 " + str.tostring(tp1Buy, format.mintick), alert.freq_once_per_bar_close)

//--------------------------------------------------------------
// Strategy entry — SHORT
//--------------------------------------------------------------
if goShort
    strategy.entry("Short", strategy.short)
    if stratDir == 1
        stOutExp := stOutExp + 1
    stratDir     := -1
    stratDirTxt  := "SELL"
    stratTrigTxt := trigDnTxt
    stratEntryBar := bar_index
    stratSL      := slSell
    stratTP1     := tp1Sell
    stratTP2     := tp2Sell
    stratRisk    := riskSell
    stratRiskAtr := riskAtrSell
    stratAge     := 0
    stratMFE     := 0.0
    stratMAE     := 0.0
    stratTp1Filled := false
    lastSigBar   := bar_index
    lastSigTxt   := "SELL"
    lastTrigTxt  := trigDnTxt
    lastEntry    := entry
    lastSL       := slSell
    lastTP1      := tp1Sell
    lastTP2      := tp2Sell
    lastRiskAtr  := riskAtrSell
    lastRR1      := (entry - tp1Sell) / math.max(riskSell, 1e-10)
    lastRR2      := (entry - tp2Sell) / math.max(riskSell, 1e-10)
    lastOutcome  := ""
    lastFinalR   := na
    stSell := stSell + 1
    //--- Levels
    if not na(lnEntry)
        line.delete(lnEntry)
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lblEntry)
        label.delete(lblEntry)
    if not na(lblSL)
        label.delete(lblSL)
    if not na(lblTP1)
        label.delete(lblTP1)
    if not na(lblTP2)
        label.delete(lblTP2)
    if showLevels
        lnEntry := line.new(bar_index, entry,  bar_index, entry,  xloc = xloc.bar_index, extend = extend.right, color = color.new(color.white, 0), style = line.style_dotted, width = 2)
        lnSL    := line.new(bar_index, slSell, bar_index, slSell, xloc = xloc.bar_index, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 2)
        lnTP1   := line.new(bar_index, tp1Sell, bar_index, tp1Sell, xloc = xloc.bar_index, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 1)
        lnTP2   := line.new(bar_index, tp2Sell, bar_index, tp2Sell, xloc = xloc.bar_index, extend = extend.right, color = color.new(color.red, 0),   style = line.style_dotted, width = 1)
        lblEntry := label.new(bar_index, entry,  "E " + f_rtxt(entry), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.white, size = size.tiny)
        lblSL    := label.new(bar_index, slSell, "SL " + f_rtxt(slSell), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,   size = size.tiny)
        lblTP1   := label.new(bar_index, tp1Sell, "T1 " + f_rtxt(tp1Sell), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red, size = size.tiny)
        lblTP2   := label.new(bar_index, tp2Sell, "T2 " + f_rtxt(tp2Sell), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = color.red,  size = size.tiny)
    if enableAlerts
        alert(syminfo.ticker + " " + timeframe.period + ": SELL | " + trigDnTxt + " | E " + str.tostring(entry, format.mintick) + " SL " + str.tostring(slSell, format.mintick) + " TP1 " + str.tostring(tp1Sell, format.mintick), alert.freq_once_per_bar_close)

//--------------------------------------------------------------
// Strategy exit management
//--------------------------------------------------------------
if strategy.position_size > 0
    exitSL = stratSL
    if enableMoveBE and enablePartialTP and strategy.position_size < strategy.position_size[1]
        stratTp1Filled := true
    if enableMoveBE and stratTp1Filled
        exitSL := strategy.position_avg_price
    if enablePartialTP
        strategy.exit("L-TP1", "Long", limit = stratTP1, stop = exitSL, qty_percent = 50)
        strategy.exit("L-TP2", "Long", limit = stratTP2, stop = exitSL, qty_percent = 50)
    else
        strategy.exit("L-TP2", "Long", limit = stratTP2, stop = exitSL, qty_percent = 100)
    stratAge := bar_index - stratEntryBar
    longMFE = (high - strategy.position_avg_price) / math.max(stratRisk, 1e-10)
    longMAE = (strategy.position_avg_price - low) / math.max(stratRisk, 1e-10)
    stratMFE := math.max(stratMFE, longMFE)
    stratMAE := math.max(stratMAE, longMAE)
    if stratAge >= outcomeBars and strategy.position_size > 0
        strategy.close("Long", comment = "EXPIRED")

if strategy.position_size < 0
    exitSL = stratSL
    if enableMoveBE and enablePartialTP and strategy.position_size > strategy.position_size[1]
        stratTp1Filled := true
    if enableMoveBE and stratTp1Filled
        exitSL := strategy.position_avg_price
    if enablePartialTP
        strategy.exit("S-TP1", "Short", limit = stratTP1, stop = exitSL, qty_percent = 50)
        strategy.exit("S-TP2", "Short", limit = stratTP2, stop = exitSL, qty_percent = 50)
    else
        strategy.exit("S-TP2", "Short", limit = stratTP2, stop = exitSL, qty_percent = 100)
    stratAge := bar_index - stratEntryBar
    shortMFE = (strategy.position_avg_price - low) / math.max(stratRisk, 1e-10)
    shortMAE = (high - strategy.position_avg_price) / math.max(stratRisk, 1e-10)
    stratMFE := math.max(stratMFE, shortMFE)
    stratMAE := math.max(stratMAE, shortMAE)
    if stratAge >= outcomeBars and strategy.position_size < 0
        strategy.close("Short", comment = "EXPIRED")

//--------------------------------------------------------------
// Detect trade closures
//--------------------------------------------------------------
if strategy.closedtrades > strategy.closedtrades[1]
    ctIdx    = strategy.closedtrades - 1
    ctExitP  = strategy.closedtrades.exit_price(ctIdx)
    ctSize   = strategy.closedtrades.size(ctIdx)
    ctPnL    = strategy.closedtrades.profit(ctIdx)
    ctIsLong = ctSize > 0
    ctEntryP = strategy.closedtrades.entry_price(ctIdx)
    ctR = ctIsLong ? (ctExitP - ctEntryP) / math.max(stratRisk, 1e-10) : (ctEntryP - ctExitP) / math.max(stratRisk, 1e-10)
    lastFinalR := ctR
    string posOut = ctIsLong ? (ctExitP >= stratTP2 ? "TP2" : ctExitP >= stratTP1 ? "TP1" : ctExitP <= stratSL ? "SL" : "EXP") : (ctExitP <= stratTP2 ? "TP2" : ctExitP <= stratTP1 ? "TP1" : ctExitP >= stratSL ? "SL" : "EXP")
    if posOut == "SL"
        stOutSl := stOutSl + 1
    else if posOut == "TP1"
        stOutTp1 := stOutTp1 + 1
    else if posOut == "TP2"
        stOutTp2 := stOutTp2 + 1
    else
        stOutExp := stOutExp + 1
    if ctPnL > 0
        stWin := stWin + 1
    else
        stLoss := stLoss + 1
    lastOutcome := posOut + " " + (ctR >= 0 ? "+" : "") + str.tostring(ctR, "#.##") + "R"
    stratDir     := 0
    stratDirTxt  := ""
    stratAge     := 0
    stratMFE     := 0.0
    stratMAE     := 0.0
    stratTp1Filled := false

//--------------------------------------------------------------
// Plots
//--------------------------------------------------------------
markerGapAtr = 0.5
trendCol = trendUp ? color.new(color.green, 0) : trendDn ? color.new(color.red, 0) : color.new(color.gray, 60)
plot(emaDir, "Trend", color = trendCol, linewidth = 2)
plot(showEMAs ? emaTrig : na, "Trigger EMA",  color = color.new(color.blue, 0), linewidth = 1)
plot(showEMAs ? emaSlow : na, "Slow EMA",     color = color.new(color.silver, 0), linewidth = 2)

plotshape(showMarkers and entryUp, "BUY",  style = shape.labelup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small, textcolor = chart.fg_color, text = "▲")
plotshape(showMarkers and entryDn, "SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0),   size = size.small, textcolor = chart.fg_color, text = "▼")

alertcondition(entryUp, title = "CanvasV V4 BUY",  message = "CanvasV V4 BUY signal")
alertcondition(entryDn, title = "CanvasV V4 SELL", message = "CanvasV V4 SELL signal")

//--------------------------------------------------------------
// Dashboard panel (NORMAL — lightweight)
//--------------------------------------------------------------
posSize     = strategy.position_size
posAvgPrice = strategy.position_avg_price
isFlat      = posSize == 0
isLong      = posSize > 0
isShort     = posSize < 0

posCurR = isLong ? (close - posAvgPrice) / math.max(stratRisk, 1e-10) : isShort ? (posAvgPrice - close) / math.max(stratRisk, 1e-10) : na
posCol  = isLong ? color.green : isShort ? color.red : color.silver
sigCol  = lastSigTxt == "BUY" ? color.green : lastSigTxt == "SELL" ? color.red : color.silver
tpCol   = lastSigTxt == "BUY" ? color.green : color.red

tfSec = timeframe.in_seconds(timeframe.period)
tfTxt = tfSec == 900 ? "15M" : tfSec == 60 ? "1M" : tfSec == 3600 ? "1H" : tfSec == 14400 ? "4H" : tfSec == 86400 ? "1D" : str.tostring(timeframe.period)

var table v4panel = na

if showPanel
    if na(v4panel)
        v4panel := table.new(position.top_right, 2, 9, border_width = 1, border_color = color.new(color.gray, 50), bgcolor = color.new(color.rgb(26, 26, 32), 10))
    trendTxt = trendUp ? "BULL ↑" : trendDn ? "BEAR ↓" : "RANGE"
    trendColN = trendUp ? color.green : trendDn ? color.red : color.silver
    posTxt = isLong ? "LONG " + str.tostring(stratAge) + "b" : isShort ? "SHORT " + str.tostring(stratAge) + "b" : lastOutcome != "" ? "FLAT · " + lastOutcome : "FLAT"
    table.cell(v4panel, 0, 0, "CANVASV V4", text_color = color.white, text_size = size.normal)
    table.cell(v4panel, 1, 0, VERSION, text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 0, 1, tfTxt, text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 1, trendTxt, text_color = trendColN, text_size = size.normal)
    table.cell(v4panel, 0, 2, "SIGNAL", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 2, lastSigTxt, text_color = sigCol, text_size = size.large)
    table.cell(v4panel, 0, 3, "POS", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 3, posTxt, text_color = posCol, text_size = size.normal)
    table.cell(v4panel, 0, 4, "ENTRY", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 4, na(lastEntry) ? "—" : f_rtxt(lastEntry), text_color = color.white, text_size = size.normal)
    table.cell(v4panel, 0, 5, "SL", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 5, na(lastSL) ? "—" : f_rtxt(lastSL), text_color = color.red, text_size = size.normal)
    table.cell(v4panel, 0, 6, "TP1/TP2", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 6, (na(lastTP1) ? "—" : f_rtxt(lastTP1)) + " / " + (na(lastTP2) ? "—" : f_rtxt(lastTP2)), text_color = tpCol, text_size = size.normal)
    table.cell(v4panel, 0, 7, "RISK", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 7, na(lastRiskAtr) ? "—" : str.tostring(lastRiskAtr, "#.##") + "A", text_color = color.white, text_size = size.small)
    table.cell(v4panel, 0, 8, "W/L", text_color = color.silver, text_size = size.small)
    table.cell(v4panel, 1, 8, str.tostring(stWin) + "W/" + str.tostring(stLoss) + "L  SL" + str.tostring(stOutSl) + " T1" + str.tostring(stOutTp1) + " T2" + str.tostring(stOutTp2), text_color = color.white, text_size = size.small)
else
    if not na(v4panel)
        table.delete(v4panel)
        v4panel := na
